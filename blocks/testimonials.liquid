{% doc %}
  Renders the "What Our Clients Say About Us" carousel.

  Entries come from the `testimonial` metaobject definition, so the same block
  serves the home page, the hike detail page, the Create a Hike page and the
  Reviews page without duplicating content.

  Renders nothing until the metaobject definition exists in the store, which
  keeps the theme installable before the content model is set up.

  Expected `testimonial` fields:
    author  single line text
    body    rich text (or multi-line text)
    date    date
    photo   file reference (optional — entries without one render narrow)

  @example
  {% content_for 'block', type: 'testimonials', id: 'testimonials' %}
{% enddoc %}

{% liquid
  assign testimonials = metaobjects.testimonial.values
  assign limit = block.settings.limit
%}

{% if testimonials.size > 0 %}
  <section class="testimonials" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="testimonials__heading">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="testimonials__subheading">{{ block.settings.subheading }}</p>
    {% endif %}

    <testimonial-carousel class="testimonials__carousel">
      <ul class="testimonials__track" tabindex="0">
        {% for testimonial in testimonials limit: limit %}
          <li class="testimonials__item">
            <article class="testimonial {% if testimonial.photo.value != blank %}testimonial--with-media{% endif %}">
              {% if testimonial.photo.value != blank %}
                <div class="testimonial__media">
                  {{
                    testimonial.photo.value
                    | image_url: width: 922
                    | image_tag: alt: testimonial.author.value, loading: 'lazy'
                  }}
                </div>
              {% endif %}

              <div class="testimonial__content">
                <p class="testimonial__author">{{ testimonial.author.value }}</p>
                <hr class="testimonial__rule">

                <div class="testimonial__text">{{ testimonial.body.value }}</div>

                <footer class="testimonial__footer">
                  {% if testimonial.date.value != blank %}
                    <time datetime="{{ testimonial.date.value | date: '%Y-%m-%d' }}" class="testimonial__date">
                      {{- testimonial.date.value | date: '%d.%m.%Y.' -}}
                    </time>
                  {% endif %}

                  <details class="testimonial__disclosure">
                    <summary class="testimonial__toggle">
                      <span class="testimonial__toggle-more">{{ 'testimonials.read_more' | t }}</span>
                      <span class="testimonial__toggle-less">{{ 'testimonials.read_less' | t }}</span>
                    </summary>
                  </details>
                </footer>
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>

      <div class="testimonials__controls">
        <button type="button" class="testimonials__control" data-direction="previous">
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
        </button>
        <button type="button" class="testimonials__control" data-direction="next">
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
        </button>
      </div>
    </testimonial-carousel>
  </section>
{% endif %}

{% stylesheet %}
  .testimonials {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: var(--spacing-section);
  }

  .testimonials__heading {
    font-family: var(--font-display--family);
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
  }

  .testimonials__subheading {
    max-width: 60ch;
  }

  .testimonials__carousel {
    display: block;
    margin-block-start: 1.5rem;
  }

  .testimonials__track {
    display: flex;
    gap: 1.875rem;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .testimonial {
    display: flex;
    box-sizing: border-box;
    width: min(24.5625rem, 85vw);
    height: 100%;
    background-color: var(--color-surface);
    border: 0.5px solid var(--color-ink-soft);
    color: var(--color-ink-soft);
  }

  .testimonial--with-media {
    width: min(61.0625rem, 85vw);
  }

  .testimonial__media {
    flex: 0 0 40%;
    align-self: center;
    padding: 1.8125rem;
  }

  .testimonial__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.8125rem;
    font-size: var(--font-size-quote);
    line-height: var(--line-height-quote);
  }

  .testimonial__author {
    font-weight: 700;
  }

  .testimonial__rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-block-start: 0.5px solid var(--color-ink-soft);
  }

  .testimonial__text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    overflow: hidden;
  }

  /* Expanding the disclosure unclamps the quote it sits beside. */
  .testimonial:has(.testimonial__disclosure[open]) .testimonial__text {
    display: block;
    overflow: visible;
  }

  .testimonial__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: auto;
    padding-block-start: 1rem;
  }

  .testimonial__date {
    opacity: 0.5;
  }

  .testimonial__toggle {
    list-style: none;
    cursor: pointer;
    text-underline-offset: 0.25em;
  }

  .testimonial__toggle::-webkit-details-marker {
    display: none;
  }

  .testimonial__toggle:hover {
    text-decoration: underline;
  }

  .testimonial__disclosure .testimonial__toggle-less,
  .testimonial__disclosure[open] .testimonial__toggle-more {
    display: none;
  }

  .testimonial__disclosure[open] .testimonial__toggle-less {
    display: inline;
  }

  .testimonials__controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-block-start: 1.5rem;
  }

  .testimonials__control {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.625rem;
    height: 2.625rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .testimonials__control[data-direction='previous'] {
    transform: scaleX(-1);
  }

  .testimonials__control svg {
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  class TestimonialCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.testimonials__track');
      if (!this.track) return;

      this.addEventListener('click', (event) => {
        const control = event.target.closest('[data-direction]');
        if (!control) return;

        const item = this.track.querySelector('.testimonials__item');
        if (!item) return;

        const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
        const step = item.getBoundingClientRect().width + gap;
        const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.track.scrollBy({
          left: control.dataset.direction === 'next' ? step : -step,
          behavior: motionOk ? 'smooth' : 'auto',
        });
      });
    }
  }

  if (!customElements.get('testimonial-carousel')) {
    customElements.define('testimonial-carousel', TestimonialCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What Our Clients Say About Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Explore reviews and stories from those who trusted us. Their satisfaction drives our innovation for better solutions."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:labels.testimonials",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials"
    }
  ]
}
{% endschema %}
