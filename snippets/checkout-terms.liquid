{% doc %}
  Renders the required "I accept the terms" checkbox that sits above checkout.
  Either document is plain text until its link is set in the theme editor. The
  checkbox is required, so checkout cannot be submitted without it; the cart
  script also keeps the checkout button disabled until it is ticked.

  @param {string} [agreement_url] - Link to the service agreement
  @param {string} [contract_url] - Link to the travel contract with airline tickets

  @example
  {% render 'checkout-terms', agreement_url: section.settings.service_agreement_url, contract_url: section.settings.travel_contract_url %}
{% enddoc %}

{%- capture agreement -%}
  {%- if agreement_url != blank -%}
    <a class="checkout-terms__link" href="{{ agreement_url }}" target="_blank" rel="noopener">
      {{- 'cart.terms.agreement' | t -}}
    </a>
  {%- else -%}
    {{- 'cart.terms.agreement' | t -}}
  {%- endif -%}
{%- endcapture -%}

{%- capture contract -%}
  {%- if contract_url != blank -%}
    <a class="checkout-terms__link" href="{{ contract_url }}" target="_blank" rel="noopener">
      {{- 'cart.terms.contract' | t -}}
    </a>
  {%- else -%}
    {{- 'cart.terms.contract' | t -}}
  {%- endif -%}
{%- endcapture -%}

<label class="checkout-terms">
  <input class="checkout-terms__input" type="checkbox" name="attributes[Terms accepted]" value="yes" required data-terms>
  <span>{{ 'cart.terms.label_html' | t: agreement: agreement, contract: contract }}</span>
</label>

{% stylesheet %}
  .checkout-terms {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 28rem;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    cursor: pointer;
  }

  .checkout-terms__input {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin: 0.1em 0 0;
    accent-color: var(--color-foreground);
    cursor: pointer;
  }

  .checkout-terms__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .checkout-terms__link:hover,
  .checkout-terms__link:focus-visible {
    text-decoration-thickness: 2px;
  }
{% endstylesheet %}
