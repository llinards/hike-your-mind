{% doc %}
  Renders a hike's dates, such as "25 September - 7 October", with the month
  names in the storefront language.

  @param {string} start - The first day of the hike
  @param {string} [end] - The last day of the hike

  @example
  {% render 'hike-dates', start: hike_start, end: hike_end %}
{% enddoc %}

{%- render 'localized-date', date: start -%}
{%- if end != blank %} - {% render 'localized-date', date: end %}{%- endif -%}
