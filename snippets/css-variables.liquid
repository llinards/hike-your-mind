{% doc %}
  Renders the theme's design tokens as CSS custom properties on `:root`.

  Values come from the HIKE YOUR MIND Figma file. Only the two colours a
  merchant may reasonably want to change (page background and foreground) and
  the layout measurements are wired to theme settings — the rest are brand
  constants and are intentionally not editable.

  Typography is brand-locked to the self-hosted faces declared in
  `snippets/fonts.liquid`, so there is no `font_picker` setting.

  Rendered once from `layout/theme.liquid`, immediately after `fonts`.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  :root {
    /* Type families */
    --font-display--family: 'Spectral', 'Iowan Old Style', 'Palatino', serif;
    --font-body--family: 'Rethink Sans', -apple-system, 'Segoe UI', system-ui, sans-serif;

    /* Type scale — sizes, line heights and tracking as measured in Figma */
    --font-size-display: 2.5rem;
    --line-height-display: 1;
    --letter-spacing-display: -0.05em;

    /* The home page's opening headline sits a step above the section headings.
       PROVISIONAL — scaled off the Home_D screenshot, not read from the Figma
       node, because the Figma file is not readable with the current seat. */
    --font-size-hero: 4.5rem;
    --line-height-hero: 1.05;
    --letter-spacing-hero: -0.04em;

    --font-size-body: 1.125rem;
    --line-height-body: 1.3;
    --letter-spacing-body: -0.02em;

    --font-size-ui: 1rem;
    --line-height-ui: 1;
    --letter-spacing-ui: -0.03em;

    --font-size-small: 0.875rem;
    --line-height-small: 1.4;
    --letter-spacing-small: -0.02em;

    /* Testimonial cards sit on their own 17px step in the design. */
    --font-size-quote: 1.0625rem;
    --line-height-quote: normal;

    /* Colours */
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-foreground-muted: #1e1e1e;
    --color-surface: #fffaec;
    --color-neutral: #363939;
    --color-hairline: rgba(0, 0, 0, 0.5);

    /* Card ink and borders. The design uses several near-blacks that are not
       distinguishable in use; this is the one used on cards. */
    --color-ink-soft: #272727;

    /* Layout — `--page-margin` itself is set responsively in critical.css */
    --page-width: {{ settings.max_page_width }};
    --page-margin-desktop: {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* Icons are drawn at 32px in the design */
    --size-icon: 2rem;

    /* Motion */
    --duration-fast: 150ms;
    --duration-base: 300ms;
    --easing-base: cubic-bezier(0.4, 0, 0.2, 1);
  }
{% endstyle %}
