{% doc %}
  Renders one linked image band: a full-width photo with the title (and, for a
  hike, its dates and price) over the bottom edge and an arrow on the right.

  @param {string} url - Where the row links to
  @param {string} title - The row's title
  @param {image} [image] - The background photo; a placeholder is drawn without one
  @param {string} [start] - A hike's first day, shown after the title
  @param {string} [end] - A hike's last day
  @param {string} [price] - Price line under the title
  @param {boolean} [eager] - Loads the photo first, for the top row

  @example
  {% render 'hike-row', url: product.url, title: product.title, image: row_image, start: hike_start, end: hike_end, price: price_line, eager: forloop.first %}
  {% render 'hike-row', url: collection.url, title: collection.title, image: collection.featured_image %}
{% enddoc %}

{%- liquid
  assign img_loading = 'lazy'
  assign img_priority = 'auto'
  if eager
    assign img_loading = 'eager'
    assign img_priority = 'high'
  endif
-%}

<a class="hike-row" href="{{ url }}">
  <div class="hike-row__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 3000
        | image_tag:
            widths: '750,1100,1500,2000,2600,3000',
            sizes: '100vw',
            loading: img_loading,
            fetchpriority: img_priority,
            alt: image.alt | default: title
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'hike-row__placeholder' }}
    {%- endif -%}
  </div>

  <div class="hike-row__caption">
    <div class="hike-row__text">
      <h2 class="hike-row__title">
        {{- title -}}
        {%- if start != blank %}
          <span class="hike-row__dates">
            {%- render 'hike-dates', start: start, end: end -%}
          </span>
        {%- endif -%}
      </h2>

      {%- if price != blank -%}
        <p class="hike-row__price">{{ price }}</p>
      {%- endif -%}
    </div>

    <span class="hike-row__arrow" aria-hidden="true">
      {{- 'icon-arrow-right.svg' | inline_asset_content -}}
    </span>
  </div>
</a>

{% stylesheet %}
  .hike-row {
    --row-height: min(64vw, 380px);
    --caption-inset: 1.5rem;
    --row-scrim: 0.25;
    --row-hover-wash: 0.2;

    position: relative;
    display: block;
    height: var(--row-height);
    overflow: hidden;
    color: var(--color-on-image);
    text-decoration: none;
  }

  @media (width >= 750px) {
    .hike-row {
      --row-height: 350px;
      --caption-inset: 3.5rem;
    }
  }

  .hike-row__media {
    position: absolute;
    inset: 0;
  }

  .hike-row__media img,
  .hike-row__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--easing-base);
  }

  .hike-row__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to top, rgb(0 0 0 / var(--row-scrim)) 0%, rgb(0 0 0 / 0) 65%);
    background-color: rgb(0 0 0 / 0);
    transition: background-color var(--duration-base) var(--easing-base);
  }

  .hike-row__caption {
    position: absolute;
    inset-inline: var(--caption-inset);
    bottom: var(--caption-inset);
    display: flex;
    gap: 1.5rem;
  }

  .hike-row__title {
    font-size: var(--font-size-display-compact);
  }

  .hike-row__dates::before {
    /* The trailing space mirrors the markup space before the span. */
    content: '| ' / '';
    margin-inline: 0.25em;
  }

  @media (width >= 750px) {
    .hike-row__title {
      font-size: var(--font-size-display);
    }
  }

  .hike-row__price {
    font-family: var(--font-display--family);
    font-size: var(--font-size-display-compact);
  }

  @media (width >= 750px) {
    .hike-row__price {
      font-size: var(--font-size-display);
    }
  }

  .hike-row__arrow {
    margin-inline-start: auto;
  }

  .hike-row__arrow svg {
    width: var(--size-icon);
    height: var(--size-icon);
    transition: transform var(--duration-base) var(--easing-base);
  }

  @media (width >= 750px) {
    .hike-row__arrow svg {
      width: 2.625rem;
      height: 2.625rem;
    }
  }

  .hike-row:hover .hike-row__media::after,
  .hike-row:focus-visible .hike-row__media::after {
    background-color: rgb(0 0 0 / var(--row-hover-wash));
  }

  .hike-row:hover .hike-row__arrow svg,
  .hike-row:focus-visible .hike-row__arrow svg {
    transform: translateX(0.375rem);
  }

  .hike-row:hover .hike-row__media img,
  .hike-row:focus-visible .hike-row__media img {
    transform: scale(1.03);
  }

  .hike-row:focus-visible {
    outline-color: var(--color-on-image);
    outline-offset: -6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hike-row__media img,
    .hike-row__media svg,
    .hike-row__media::after,
    .hike-row__arrow svg {
      transition: none;
    }

    .hike-row:hover .hike-row__arrow svg,
    .hike-row:focus-visible .hike-row__arrow svg,
    .hike-row:hover .hike-row__media img,
    .hike-row:focus-visible .hike-row__media img {
      transform: none;
    }
  }
{% endstylesheet %}
