{% comment %}Enquiry page: heading, feature icons and a quote above a Shopify contact form.{% endcomment %}

{%- liquid
  assign heading_tag = section.settings.heading_level | default: 'h1'
-%}

{%- capture terms_link -%}
  <a class="contact__terms-link" href="{{ section.settings.terms_url | default: routes.root_url }}">
    {{- 'contact.form.terms_link' | t -}}
  </a>
{%- endcapture -%}

<div
  class="contact"
  style="
    --quote-size: {{ section.settings.quote_size }}px;
    --quote-rotation: {{ section.settings.quote_rotation }}deg;
  "
>
  <div class="contact__intro">
    <div class="contact__lede">
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="contact__heading">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="contact__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="contact__features" role="list">
          {%- for block in section.blocks -%}
            <li class="contact__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="contact__feature-icon">
                  {{
                    block.settings.icon
                    | image_url: width: 160
                    | image_tag: widths: '40,60,80,120,160', sizes: '40px', loading: 'lazy', alt: block.settings.icon.alt
                  }}
                </span>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <span class="contact__feature-text">{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.quote != blank -%}
      <div class="contact__aside">
        <blockquote class="contact__quote">
          {{- section.settings.quote | escape | newline_to_br -}}
        </blockquote>

        <span class="contact__arrow" aria-hidden="true">
          {{- 'icon-arrow-right.svg' | inline_asset_content -}}
        </span>
      </div>
    {%- endif -%}
  </div>

  <div class="contact__form-wrapper">
    {%- form 'contact', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact__notice contact__notice--success" role="status">
          {{- 'contact.form.success' | t -}}
        </p>
      {%- elsif form.errors -%}
        <div class="contact__notice contact__notice--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="contact__fields">
        <div class="contact__field">
          <label class="contact__label" for="contact-name">{{ 'contact.form.name' | t }}</label>
          <input
            class="contact__input"
            id="contact-name"
            type="text"
            name="contact[name]"
            autocomplete="name"
            required
          >
        </div>

        <div class="contact__field">
          <label class="contact__label" for="contact-phone">{{ 'contact.form.phone' | t }}</label>
          <input
            class="contact__input"
            id="contact-phone"
            type="tel"
            name="contact[phone]"
            autocomplete="tel"
            required
          >
        </div>

        <div class="contact__field">
          <label class="contact__label" for="contact-email">{{ 'contact.form.email' | t }}</label>
          <input
            class="contact__input"
            id="contact-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            required
          >
        </div>

        <div class="contact__field contact__field--wide">
          <label class="contact__label" for="contact-body">{{ 'contact.form.message' | t }}</label>
          <textarea class="contact__input contact__textarea" id="contact-body" name="contact[body]" rows="5" required></textarea>
        </div>
      </div>

      <div class="contact__consent">
        <input
          class="contact__checkbox"
          id="contact-terms"
          type="checkbox"
          name="contact[terms_accepted]"
          value="{{ 'contact.form.terms_value' | t }}"
          required
        >
        <label class="contact__consent-label" for="contact-terms">
          {{ 'contact.form.terms_html' | t: link: terms_link }}
        </label>
      </div>

      <button class="contact__submit" type="submit">{{ 'contact.form.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .contact {
    --quote-scale: 0.55;
    --quote-rendered-size: min(calc(var(--quote-size, 60px) * var(--quote-scale)), 7vw);

    display: flex;
    flex-direction: column;
    gap: var(--spacing-section);
    padding-block: var(--spacing-section);
  }

  .contact__intro {
    display: grid;
    gap: var(--spacing-section);
  }

  @media (width >= 750px) {
    .contact__intro {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact__lede {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .contact__body {
    font-family: var(--font-display--family);
  }

  .contact__body p + p {
    margin-block-start: 1rem;
  }

  .contact__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-block-start: auto;
    padding: 0;
    padding-block-start: var(--spacing-section);
    list-style: none;
  }

  @media (width >= 1024px) {
    .contact__features {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .contact__feature {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact__feature-icon img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }

  .contact__feature-text {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .contact__aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .contact__quote {
    rotate: var(--quote-rotation, -4deg);
    transform-origin: 50% 50%;
    font-family: var(--font-script--family);
    font-size: var(--quote-rendered-size);
    line-height: 1.15;
    text-align: center;
  }

  .contact__arrow svg {
    width: 2.5rem;
    height: 2.5rem;
    rotate: 90deg;
  }

  @media (width >= 640px) {
    .contact {
      --quote-scale: 0.7;
    }
  }

  @media (width >= 768px) {
    .contact {
      --quote-scale: 0.85;
    }
  }

  @media (width >= 1024px) {
    .contact {
      --quote-rendered-size: var(--quote-size, 60px);
    }
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact__fields {
    display: grid;
    gap: 1.5rem;
  }

  @media (width >= 750px) {
    .contact__fields {
      grid-template-columns: repeat(3, 1fr);
    }

    .contact__field--wide {
      grid-column: 1 / -1;
    }
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact__label,
  .contact__consent-label {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .contact__input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 0.5px solid var(--color-hairline);
    border-radius: var(--style-border-radius-inputs);
    background-color: transparent;
    color: var(--color-foreground);
    font-family: inherit;
    font-size: var(--font-size-ui);
  }

  .contact__textarea {
    resize: vertical;
  }

  .contact__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .contact__checkbox {
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    margin-block-start: 0.125rem;
    accent-color: var(--color-foreground);
  }

  .contact__submit {
    align-self: flex-start;
    padding: 0.875rem 2.5rem;
    border: 0.5px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-family: inherit;
    font-size: var(--font-size-ui);
    cursor: pointer;
    transition: opacity var(--duration-base) var(--easing-base);
  }

  .contact__submit:hover,
  .contact__submit:focus-visible {
    opacity: 0.85;
  }

  .contact__notice {
    padding: 1rem;
    border: 0.5px solid var(--color-hairline);
    font-size: var(--font-size-small);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Create a hike with us"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:labels.heading_level",
      "info": "t:info.heading_level",
      "options": [
        { "value": "h1", "label": "t:options.heading_level.h1" },
        { "value": "h2", "label": "t:options.heading_level.h2" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.paragraph",
      "default": "<p>Tell us where you would like to walk and what you hope to find there. We will shape the route, the pace and the nights around you.</p>"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "t:labels.quote",
      "info": "t:info.quote",
      "default": "Let's plan\nyour journey"
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "t:labels.quote_size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "quote_rotation",
      "label": "t:labels.quote_rotation",
      "info": "t:info.quote_rotation",
      "min": -15,
      "max": 15,
      "step": 1,
      "unit": "deg",
      "default": -4
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "t:labels.terms_url",
      "info": "t:info.terms_url"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Feature"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:general.contact",
      "blocks": [
        { "type": "feature", "settings": { "text": "Small groups" } },
        { "type": "feature", "settings": { "text": "Flights included" } },
        { "type": "feature", "settings": { "text": "Curated routes" } },
        { "type": "feature", "settings": { "text": "20% deposit" } }
      ]
    }
  ]
}
{% endschema %}
