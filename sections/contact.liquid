{% comment %}Create a hike: a faded image panel of copy and icons beside a script-led contact form.{% endcomment %}

{%- liquid
  assign heading_tag = section.settings.heading_level | default: 'h1'
  assign panel_opacity = section.settings.image_opacity | divided_by: 100.0
-%}

{%- capture terms_link -%}
  <a class="contact__terms-link" href="{{ section.settings.terms_url | default: routes.root_url }}">
    {{- 'contact.form.terms_link' | t -}}
  </a>
{%- endcapture -%}

<div class="contact full-width">
  <div class="contact__panel" style="--panel-opacity: {{ panel_opacity }};">
    {%- if section.settings.image != blank -%}
      <div class="contact__panel-media" aria-hidden="true">
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
              widths: '600,800,1100,1500,2000',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: ''
        }}
      </div>
    {%- endif -%}

    <div class="contact__panel-content">
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="contact__heading">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="contact__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="contact__features" role="list">
          {%- for block in section.blocks -%}
            <li class="contact__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="contact__feature-icon">
                  {{
                    block.settings.icon
                    | image_url: width: 180
                    | image_tag: widths: '45,60,90,120,180', sizes: '60px', loading: 'lazy', alt: ''
                  }}
                </span>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <span class="contact__feature-text">{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="contact__aside">
    {%- if section.settings.quote != blank -%}
      <blockquote class="contact__quote">
        {{- section.settings.quote | escape | newline_to_br -}}
      </blockquote>

      <span class="contact__arrow" aria-hidden="true">
        {{- 'icon-arrow-right.svg' | inline_asset_content -}}
      </span>
    {%- endif -%}

    {%- form 'contact', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact__notice contact__notice--success" role="status">
          {{- 'contact.form.success' | t -}}
        </p>
      {%- elsif form.errors -%}
        <div class="contact__notice contact__notice--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="contact__field">
        <label class="visually-hidden" for="contact-name">{{ 'contact.form.name' | t }}</label>
        <input
          class="contact__input"
          id="contact-name"
          type="text"
          name="contact[name]"
          placeholder="{{ 'contact.form.name' | t }}"
          autocomplete="name"
          required
        >
      </div>

      <div class="contact__field">
        <label class="visually-hidden" for="contact-phone">{{ 'contact.form.phone' | t }}</label>
        <input
          class="contact__input"
          id="contact-phone"
          type="tel"
          name="contact[phone]"
          placeholder="{{ 'contact.form.phone' | t }}"
          autocomplete="tel"
          required
        >
      </div>

      <div class="contact__field">
        <label class="visually-hidden" for="contact-email">{{ 'contact.form.email' | t }}</label>
        <input
          class="contact__input"
          id="contact-email"
          type="email"
          name="contact[email]"
          placeholder="{{ 'contact.form.email' | t }}"
          autocomplete="email"
          spellcheck="false"
          autocapitalize="off"
          required
        >
      </div>

      <div class="contact__field">
        <label class="visually-hidden" for="contact-body">{{ 'contact.form.message' | t }}</label>
        <textarea
          class="contact__input contact__textarea"
          id="contact-body"
          name="contact[body]"
          rows="7"
          placeholder="{{ 'contact.form.message' | t }}"
          required
        ></textarea>
      </div>

      <div class="contact__consent">
        <input
          class="contact__checkbox"
          id="contact-terms"
          type="checkbox"
          name="contact[terms_accepted]"
          value="{{ 'contact.form.terms_value' | t }}"
          required
        >
        <label class="contact__consent-label" for="contact-terms">
          {{ 'contact.form.terms_html' | t: link: terms_link }}
        </label>
      </div>

      <button class="contact__submit" type="submit">{{ 'contact.form.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .contact {
    --quote-scale: 0.6;
    --quote-rendered-size: min(calc(var(--quote-size, 60px) * var(--quote-scale)), 9vw);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (width >= 750px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--spacing-section);
      align-items: start;
      padding-inline-end: var(--page-margin);
    }
  }

  .contact__panel {
    position: relative;
    isolation: isolate;
    padding: var(--spacing-section) var(--page-margin);
  }

  @media (width >= 750px) {
    .contact__panel {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      padding-block-end: calc(var(--spacing-section) * 1.5);
    }
  }

  .contact__panel-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .contact__panel-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: var(--panel-opacity, 0.4);
  }

  .contact__panel-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-section);
    height: 100%;
  }

  .contact__body p + p {
    margin-block-start: 1rem;
  }

  .contact__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-block-start: auto;
    padding: 0;
    padding-block-start: var(--spacing-section);
    list-style: none;
  }

  @media (width >= 750px) {
    .contact__features {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .contact__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0.75rem;
    text-align: center;
  }

  /* Thin rules between the icons, as in the design — but never on a row's first cell. */
  .contact__feature + .contact__feature {
    border-inline-start: 0.5px solid var(--color-hairline);
  }

  @media (width < 750px) {
    .contact__feature:nth-child(odd) {
      border-inline-start: 0;
    }
  }

  .contact__feature-icon img {
    width: 3.75rem;
    height: 3.75rem;
    object-fit: contain;
  }

  .contact__feature-text {
    font-family: var(--font-display--family);
    font-size: var(--font-size-lead);
    line-height: 1.15;
    color: var(--color-neutral);
  }

  .contact__aside {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-section) var(--page-margin);
  }

  @media (width >= 750px) {
    .contact__aside {
      padding-inline: 0;
    }
  }

  .contact__quote {
    align-self: start;
    font-family: var(--font-script--family);
    font-size: var(--quote-rendered-size);
    line-height: 1.15;
  }

  .contact__arrow {
    align-self: center;
    margin-block: 1rem var(--spacing-section);
  }

  .contact__arrow svg {
    width: 3.5rem;
    height: 3.5rem;
    rotate: 55deg;
  }

  @media (width >= 1024px) {
    .contact {
      --quote-rendered-size: var(--quote-size, 60px);
    }
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact__input {
    width: 100%;
    padding: 1.125rem 1.25rem;
    border: 0.5px solid var(--color-hairline);
    border-radius: var(--style-border-radius-inputs);
    background-color: transparent;
    color: var(--color-foreground);
    font-family: inherit;
    font-size: var(--font-size-ui);
  }

  .contact__input::placeholder {
    color: var(--color-foreground-muted);
    opacity: 1;
  }

  .contact__textarea {
    resize: vertical;
  }

  .contact__consent {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact__checkbox {
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-foreground);
  }

  .contact__consent-label {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .contact__submit {
    width: 100%;
    padding: 1.125rem 2rem;
    border: 0;
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-family: inherit;
    font-size: var(--font-size-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity var(--duration-base) var(--easing-base);
  }

  .contact__submit:hover,
  .contact__submit:focus-visible {
    opacity: 0.85;
  }

  .contact__notice {
    padding: 1rem;
    border: 0.5px solid var(--color-hairline);
    font-size: var(--font-size-small);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Share Your Idea with Us"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:labels.heading_level",
      "info": "t:info.heading_level",
      "options": [
        {
          "value": "h1",
          "label": "t:options.heading_level.h1"
        },
        {
          "value": "h2",
          "label": "t:options.heading_level.h2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.paragraph",
      "default": "<p>Do you have an idea for a special hiking experience?</p><p>Perhaps you are a photographer, yoga teacher, artist, guide, coach or simply someone with a meaningful idea to share.</p><p>Tell us about your idea, the preferred location, approximate time and how many people you imagine joining.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.background"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "t:labels.image_opacity",
      "info": "t:info.image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "t:labels.quote",
      "info": "t:info.quote",
      "default": "We can't wait\nto hear\nyour idea!"
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "t:labels.quote_size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "t:labels.terms_url",
      "info": "t:info.terms_url"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Feature"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:general.contact",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "Personal Experience"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Carefully Planned"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Made for Your Group"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Memories that Last"
          }
        }
      ]
    }
  ]
}
{% endschema %}
