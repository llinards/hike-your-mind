{% comment %} Picked collections as image bands, laid out like the hikes collection page. {% endcomment %}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title | default: collection.title
  endif
-%}

<div class="collection-rows full-width">
  <div class="collection-rows__intro">
    {%- if heading != blank -%}
      <h1 class="collection-rows__heading">{{ heading }}</h1>
    {%- endif -%}

    {% render 'hike-features', blocks: section.blocks %}
  </div>

  <div class="collection-rows__rows">
    {%- if section.settings.collections != blank -%}
      <ul class="collection-rows__list" role="list">
        {%- for picked in section.settings.collections -%}
          <li>
            {% render 'hike-row',
              url: picked.url,
              title: picked.title,
              image: picked.featured_image,
              eager: forloop.first
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="collection-rows__empty">{{ 'collections.rows.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .collection-rows {
    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: var(--spacing-section);
  }

  .collection-rows > * {
    grid-column: 2;
  }

  .collection-rows__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block-start: var(--spacing-section);
  }

  .collection-rows__rows {
    padding-bottom: var(--spacing-section);
  }

  .collection-rows__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-section);
    padding: 0;
    list-style: none;
  }

  .collection-rows__empty {
    padding-block: var(--spacing-section);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_rows",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.collection_rows_heading"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:labels.collections",
      "info": "t:info.collection_rows_selection",
      "limit": 50
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "mountains-light.svg", "label": "t:options.icon.mountains" },
            { "value": "airplane-tilt-light.svg", "label": "t:options.icon.airplane" },
            { "value": "calendar-check-light.svg", "label": "t:options.icon.calendar" }
          ],
          "default": "mountains-light.svg"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "t:general.collection_rows" }]
}
{% endschema %}
