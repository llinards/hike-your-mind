{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page">
  <div class="page__intro">
    <div class="page__text">
      <h1 class="page__heading">{{ page.title }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="page__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if page.content != blank -%}
    <div class="page__content">{{ page.content }}</div>
  {%- endif -%}
</div>

{% stylesheet %}

  /* One gap spaces the title, subheading and page content alike. */
  .page {
    --page-gap: 1rem;

    display: flex;
    flex-direction: column;
    gap: var(--page-gap);
    padding-block-start: var(--spacing-section);
  }

  .page__intro {
    display: flex;
    flex-direction: column;
    gap: var(--page-gap);
  }

  .page__text {
    display: flex;
    flex-direction: column;
    gap: var(--page-gap);
  }
  .page__subheading {
    font-family: var(--font-display--family);
  }

  /*
   * 42px before the footer, so it doesn't butt against the text. Kept on the
   * content rather than .page so the reviews template, where this intro sits
   * directly above the reviews section, is unchanged.
   */
  .page__content {
    padding-block-end: 2.625rem;
  }

  @media (width >= 750px) {
    .page__intro {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Subheading for this page"
    }
  ]
}
{% endschema %}
