{% comment %} The hike destinations behind this collection's upcoming hikes as image bands, soonest first. {% endcomment %}

<div class="all-hikes full-width">
  <div class="all-hikes__intro">
    <h1 class="all-hikes__heading">{{ collection.title }}</h1>

    {% render 'hike-features', blocks: section.blocks %}
  </div>

  <div class="all-hikes__rows">
    {%- comment -%}
      Every collection using the hikes template that an upcoming hike here (first 50)
      also belongs to, so a new destination appears on its own. Destinations are
      ordered by their soonest hike; ones with only past hikes drop out.
    {%- endcomment -%}
    {%- liquid
      assign today = 'now' | date: '%Y%m%d' | plus: 0
      assign sort_keys = ''

      for product in collection.products
        assign start_day = product.metafields.custom.hike_start_date.value | date: '%Y%m%d'
        assign position = forloop.index0 | prepend: '00' | slice: -3, 3

        if start_day == blank
          assign sort_key = '100000000'
        else
          assign start_number = start_day | plus: 0
          if start_number < today
            continue
          endif
          assign sort_key = start_day | prepend: '0'
        endif

        assign sort_keys = sort_keys | append: sort_key | append: '-' | append: position | append: ','
      endfor

      assign sort_keys = sort_keys | split: ',' | sort

      assign group_handles = '|'
      for sort_key in sort_keys
        assign product_index = sort_key | split: '-' | last | plus: 0
        assign product = collection.products[product_index]

        for group in product.collections
          if group.template_suffix == 'hikes'
            unless group.handle == collection.handle
              assign marker = '|' | append: group.handle | append: '|'
              unless group_handles contains marker
                assign group_handles = group_handles | append: group.handle | append: '|'
              endunless
            endunless
          endif
        endfor
      endfor

      assign group_handles = group_handles | remove_first: '|' | split: '|'
    -%}

    {%- if group_handles.size > 0 -%}
      <ul class="all-hikes__list" role="list">
        {%- for group_handle in group_handles -%}
          {%- assign group = collections[group_handle] -%}
          <li>
            {% render 'hike-row',
              url: group.url,
              title: group.title,
              image: group.featured_image,
              eager: forloop.first
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="all-hikes__empty">{{ 'collections.hikes.no_results' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .all-hikes {
    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: var(--spacing-section);
  }

  .all-hikes > * {
    grid-column: 2;
  }

  .all-hikes__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block-start: var(--spacing-section);
  }

  .all-hikes__rows {
    padding-bottom: var(--spacing-section);
  }

  .all-hikes__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-section);
    padding: 0;
    list-style: none;
  }

  .all-hikes__empty {
    padding-block: var(--spacing-section);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_all_hikes",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "mountains-light.svg", "label": "t:options.icon.mountains" },
            { "value": "airplane-tilt-light.svg", "label": "t:options.icon.airplane" },
            { "value": "calendar-check-light.svg", "label": "t:options.icon.calendar" }
          ],
          "default": "mountains-light.svg"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
