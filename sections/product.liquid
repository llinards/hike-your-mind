{% comment %}Standard product: the shared gallery beside a purchase summary and add to cart.{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant | default: product.variants.first
  assign max_quantity = section.settings.max_quantity

  comment
    BookX marks its bookable products with this tag; those are rented by the day.
  endcomment
  assign product_tags = product.tags | join: ',' | downcase
  assign per_day = false
  if product_tags contains 'bookeasy'
    assign per_day = true
  endif

  assign summary_title = 'product.standard.purchase_summary' | t
  if per_day
    assign summary_title = 'product.standard.rent_summary' | t
  endif

  comment
    With one option the radios carry variant ids, so choosing works without
    JavaScript. With more, a hidden field holds the match the script works out.
  endcomment
  assign single_option = false
  if product.options.size == 1
    assign single_option = true
  endif

  assign compare_amount = ''
  if variant.compare_at_price > variant.price
    assign compare_amount = variant.compare_at_price | money
  endif
-%}

{%- comment -%}
  Every variant's money strings are rendered once per allowed quantity, so the
  shop's own money format stays authoritative instead of being rebuilt in
  JavaScript.
{%- endcomment -%}
{%- capture variant_map -%}
  {
    {%- for option in product.variants -%}
      {%- liquid
        assign variant_compare = ''
        if option.compare_at_price > option.price
          assign variant_compare = option.compare_at_price | money
        endif
      -%}
      "{{ option.id }}": {
        "available": {{ option.available | json }},
        "price": {{ option.price | money | json }},
        "compare": {{ variant_compare | json }},
        "options": {{ option.options | json }},
        "totals": {
          {%- for quantity in (1..max_quantity) -%}
            "{{ quantity }}": {{ option.price | times: quantity | money | json }}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
{%- endcapture -%}

<div class="product-page">
  <h1 class="product-page__title">{{ product.title }}</h1>

  {% render 'product-gallery', product: product %}

  <product-purchase
    class="product-page__info"
    data-max="{{ max_quantity }}"
    data-variant="{{ variant.id }}"
    {% if single_option %}data-single-option{% endif %}
  >
    <p class="product-page__price">
      <s class="product-page__compare" data-compare>{{ compare_amount }}</s>
      <span data-price>{{ variant.price | money }}</span>
      {%- if per_day -%}
        <span class="product-page__unit">{{ 'collections.gear.per_day' | t }}</span>
      {%- endif -%}
    </p>

    <p class="product-page__tax">{{ 'product.standard.tax_note' | t }}</p>

    {%- if product.description != blank -%}
      <div class="product-page__description">{{ product.description }}</div>
    {%- endif -%}

    {%- form 'product', product, class: 'product-page__form' -%}
      <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
      {%- unless single_option -%}
        <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>
      {%- endunless -%}

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign option_name = option.name | downcase
            assign is_color = false
            if option_name == 'color' or option_name == 'colour'
              assign is_color = true
            endif
          -%}

          <div class="product-page__option" role="radiogroup" aria-label="{{ option.name }}">
            <span class="product-page__option-name">{{ option.name }}</span>

            <div class="product-page__values">
              {%- for value in option.values -%}
                <label class="product-page__value{% unless value.available %} is-unavailable{% endunless %}">
                  <input
                    class="visually-hidden"
                    type="radio"
                    {% if single_option %}
                      name="id"
                      value="{{ value.variant.id }}"
                    {% else %}
                      name="option-{{ forloop.parentloop.index }}"
                      value="{{ value.name | escape }}"
                    {% endif %}
                    data-option
                    {% if value.selected %}checked{% endif %}
                    {% unless value.available %}disabled{% endunless %}
                  >

                  {%- if is_color and value.swatch.color -%}
                    <span class="product-page__dot" style="--dot: {{ value.swatch.color }}"></span>
                    <span class="visually-hidden">{{ value.name }}</span>
                  {%- elsif is_color and value.swatch.image -%}
                    <span
                      class="product-page__dot"
                      style="background-image: url({{ value.swatch.image | image_url: width: 60 }})"
                    ></span>
                    <span class="visually-hidden">{{ value.name }}</span>
                  {%- else -%}
                    <span class="product-page__value-label">{{ value.name }}</span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <div class="product-page__quantity">
        <label class="product-page__quantity-label" for="product-quantity-{{ section.id }}">
          {{- 'product.standard.quantity' | t -}}
        </label>

        <div class="product-page__quantity-row">
          <div class="quantity">
            <button class="quantity__button" type="button" data-step="-1">
              <span aria-hidden="true">&minus;</span>
              <span class="visually-hidden">{{ 'product.standard.decrease' | t }}</span>
            </button>

            <input
              class="quantity__input"
              id="product-quantity-{{ section.id }}"
              type="number"
              name="quantity"
              value="1"
              min="1"
              max="{{ max_quantity }}"
              step="1"
              inputmode="numeric"
              data-quantity
            >

            <button class="quantity__button" type="button" data-step="1">
              <span aria-hidden="true">+</span>
              <span class="visually-hidden">{{ 'product.standard.increase' | t }}</span>
            </button>
          </div>

          {%- if per_day -%}
            {%- comment -%}
              The BookX app injects its button elsewhere on the page; the script moves it in here.
            {%- endcomment -%}
            <div class="product-page__booking" data-booking></div>
          {%- endif -%}
        </div>
      </div>

      <div class="summary">
        <h2 class="summary__title">{{ summary_title }}</h2>

        <div class="summary__row">
          <span class="summary__label">
            {%- if per_day -%}
              {{ 'product.standard.day_rate' | t }}
            {%- else -%}
              {{ 'product.standard.unit_price' | t }}
            {%- endif -%}
          </span>
          <span class="summary__value" data-price>{{ variant.price | money }}</span>
        </div>

        <div class="summary__row">
          <span class="summary__label">{{ 'product.standard.quantity' | t }}</span>
          <span class="summary__value" data-count>1</span>
        </div>

        <div class="summary__row summary__row--total">
          <span class="summary__label">{{ 'product.standard.total' | t }}</span>
          <span class="summary__value" data-total>{{ variant.price | money }}</span>
        </div>
      </div>

      <button class="product-page__submit" type="submit" data-submit {% unless variant.available %}disabled{% endunless %}>
        {%- if variant.available -%}
          {{ 'product.standard.add_to_cart' | t }}
        {%- else -%}
          {{ 'product.standard.sold_out' | t }}
        {%- endif -%}
      </button>

      <span class="visually-hidden" data-label-add>{{ 'product.standard.add_to_cart' | t }}</span>
      <span class="visually-hidden" data-label-sold-out>{{ 'product.standard.sold_out' | t }}</span>
    {%- endform -%}

    <script type="application/json" data-variant-map>{{ variant_map }}</script>
  </product-purchase>
</div>

{% stylesheet %}
  .product-page {
    --summary-ink: color-mix(in oklab, var(--color-foreground) 55%, var(--color-background));

    display: grid;
    gap: 1.5rem;
    padding-block: var(--spacing-section);
  }

  @media (width >= 1024px) {
    .product-page {
      grid-template-columns: minmax(0, 54fr) minmax(0, 42fr);
      grid-template-areas:
        'title title'
        'gallery info';
      column-gap: var(--spacing-section);
      align-items: start;
    }

    .product-page__title {
      grid-area: title;
    }

    .product-gallery {
      grid-area: gallery;
    }

    .product-page__info {
      grid-area: info;
    }
  }

  /* The heading moves beside the gallery once the column is wide enough to hold it. */
  @media (width >= 1280px) {
    .product-page {
      grid-template-areas:
        'gallery title'
        'gallery info';
      grid-template-rows: auto 1fr;
    }
  }

  .product-page__title {
    font-size: var(--font-size-display);
  }

  .product-page__info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .product-page__price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    font-family: var(--font-display--family);
    font-size: var(--font-size-display-compact);
    letter-spacing: var(--letter-spacing-display);
  }

  .product-page__compare,
  .product-page__unit {
    color: var(--summary-ink);
  }

  .product-page__compare:empty {
    display: none;
  }

  .product-page__tax {
    margin-block-start: -1rem;
    font-size: var(--font-size-small);
    color: var(--summary-ink);
  }

  .product-page__description {
    font-family: var(--font-display--family);
    line-height: 1.45;
  }

  .product-page__description > * + * {
    margin-block-start: 0.75rem;
  }

  .product-page__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .product-page__option {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-page__option-name {
    font-size: var(--font-size-small);
    color: var(--summary-ink);
  }

  .product-page__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .product-page__value {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }

  .product-page__value.is-unavailable {
    opacity: 0.35;
    cursor: default;
  }

  .product-page__dot {
    width: 1.25rem;
    height: 1.25rem;
    border: 0.5px solid var(--color-hairline);
    border-radius: 50%;
    background-color: var(--dot, transparent);
    background-size: cover;
  }

  .product-page__value-label {
    font-size: var(--font-size-body);
    color: var(--summary-ink);
  }

  .product-page__value:has(input:checked) .product-page__dot {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product-page__value:has(input:checked) .product-page__value-label {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product-page__value:has(input:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .product-page__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-page__quantity-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: stretch;
  }

  .product-page__booking {
    flex: 1 1 12rem;
  }

  /* The app's own button, restyled to sit beside the stepper. */
  .product-page__booking :is(button, a) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0.75rem 1.5rem;
    border: 0.5px solid var(--color-hairline);
    border-radius: var(--style-border-radius-inputs);
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--font-size-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--duration-base) var(--easing-base),
      color var(--duration-base) var(--easing-base);
  }

  .product-page__booking :is(button, a):hover,
  .product-page__booking :is(button, a):focus-visible {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .product-page__quantity-label {
    font-size: var(--font-size-small);
    color: var(--summary-ink);
  }

  .quantity {
    display: flex;
    align-items: center;
    border: 0.5px solid var(--color-hairline);
    border-radius: var(--style-border-radius-inputs);
  }

  .quantity__button {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .quantity__button[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .quantity__input {
    width: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--font-size-ui);
    text-align: center;
    appearance: textfield;
  }

  .quantity__input::-webkit-outer-spin-button,
  .quantity__input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--font-size-body);
    color: var(--summary-ink);
  }

  .summary__title {
    font-family: var(--font-body--family);
    font-size: var(--font-size-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: var(--line-height-small);
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .summary__row {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
  }

  .summary__label {
    font-size: var(--font-size-body);
  }

  .summary__value {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .summary__row--total {
    padding-block-start: 1rem;
    border-block-start: 0.5px solid var(--color-hairline);
    font-weight: 700;
    color: var(--color-foreground);
  }

  .product-page__submit {
    padding: 1rem;
    border: 0;
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-family: inherit;
    font-size: var(--font-size-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity var(--duration-base) var(--easing-base);
  }

  .product-page__submit:hover,
  .product-page__submit:focus-visible {
    opacity: 0.85;
  }

  .product-page__submit[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-page__submit,
    .product-page__booking :is(button, a) {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Matches the chosen options to a variant and swaps in the money strings Liquid pre-rendered. */
  class ProductPurchase extends HTMLElement {
    connectedCallback() {
      this.input = this.querySelector('[data-quantity]');
      if (!this.input) return;

      this.field = this.querySelector('[data-variant-id]');
      this.current = this.dataset.variant;
      this.max = Number(this.dataset.max) || 10;
      this.steps = Array.from(this.querySelectorAll('[data-step]'));
      this.options = Array.from(this.querySelectorAll('[data-option]'));
      this.prices = Array.from(this.querySelectorAll('[data-price]'));
      this.total = this.querySelector('[data-total]');
      this.count = this.querySelector('[data-count]');
      this.compare = this.querySelector('[data-compare]');
      this.submit = this.querySelector('[data-submit]');

      const map = this.querySelector('[data-variant-map]');
      try {
        this.variants = map ? JSON.parse(map.textContent) : {};
      } catch (error) {
        this.variants = {};
      }

      this.addEventListener('click', (event) => {
        const step = event.target.closest('[data-step]');
        if (step) this.setQuantity(this.quantity() + Number(step.dataset.step));
      });

      this.input.addEventListener('change', () => this.setQuantity(this.quantity()));
      this.addEventListener('change', (event) => {
        if (event.target.closest('[data-option]')) this.selectVariant();
      });

      this.adoptBooking();
      this.render();
    }

    /* The app adds its button after the page loads, so it is moved in whenever it appears. */
    adoptBooking() {
      const slot = this.querySelector('[data-booking]');
      if (!slot) return;

      const move = () => {
        const widget = document.querySelector('.bookeasy-button-container');
        if (!widget || widget.parentElement === slot) return;
        slot.append(widget);
      };

      move();
      this.watcher = new MutationObserver(move);
      this.watcher.observe(document.body, { childList: true, subtree: true });
    }

    disconnectedCallback() {
      if (this.watcher) this.watcher.disconnect();
    }

    quantity() {
      return Math.round(Number(this.input.value)) || 1;
    }

    setQuantity(value) {
      this.input.value = Math.min(Math.max(value, 1), this.max);
      this.render();
    }

    chosen() {
      return this.options.filter((option) => option.checked).map((option) => option.value);
    }

    selectVariant() {
      if (this.hasAttribute('data-single-option')) {
        const picked = this.options.find((option) => option.checked);
        if (picked) this.current = picked.value;
        this.render();
        return;
      }

      const chosen = this.chosen();
      const match = Object.entries(this.variants).find(([, variant]) =>
        chosen.every((value, index) => variant.options[index] === value)
      );

      if (match) {
        this.current = match[0];
        if (this.field) this.field.value = match[0];
      }

      this.render();
    }

    render() {
      const quantity = this.quantity();
      const variant = this.variants[this.current];

      this.steps.forEach((step) => {
        step.disabled = Number(step.dataset.step) < 0 ? quantity <= 1 : quantity >= this.max;
      });

      if (this.count) this.count.textContent = quantity;
      if (!variant) return;

      this.prices.forEach((price) => {
        price.textContent = variant.price;
      });

      if (this.total) this.total.textContent = variant.totals[quantity] || variant.price;
      if (this.compare) this.compare.textContent = variant.compare;

      if (this.submit) {
        this.submit.disabled = !variant.available;
        const label = variant.available ? '[data-label-add]' : '[data-label-sold-out]';
        this.submit.textContent = this.querySelector(label)?.textContent.trim();
      }
    }
  }

  if (!customElements.get('product-purchase')) customElements.define('product-purchase', ProductPurchase);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "range",
      "id": "max_quantity",
      "label": "t:labels.max_quantity",
      "info": "t:info.max_quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
