{% comment %} Hike departures as full-bleed bands, filtered by country without a page reload. {% endcomment %}

{%- liquid
  assign country_filters = collection.filters | where: 'param_name', 'filter.p.m.custom.country'
  assign country_filter = country_filters | first

  assign fallback_countries = ''
  if country_filter.values.size == 0
    for product in collection.products limit: 50
      assign country = product.metafields.custom.country.value
      if country != blank
        unless fallback_countries contains country
          assign fallback_countries = fallback_countries | append: country | append: '|'
        endunless
      endif
    endfor
  endif
  assign fallback_countries = fallback_countries | split: '|' | sort
-%}

<hike-list class="hikes full-width" data-section-id="{{ section.id }}">
  <div class="hikes__intro">
    <div class="hikes__text">
      <h1 class="hikes__heading">{{ collection.title }}</h1>

      {%- comment -%}
        Left empty, the line comes from the theme locales so each language has its own.
      {%- endcomment -%}
      <p class="hikes__subheading">
        {%- if section.settings.subheading != blank -%}
          {{ section.settings.subheading }}
        {%- else -%}
          {{ 'collections.hikes.subheading' | t }}
        {%- endif -%}
      </p>
    </div>

    <div class="hikes__filters" data-filters>
      {% render 'filter-dropdown',
        filters: country_filters,
        fallback_param: 'filter.p.m.custom.country',
        fallback_values: fallback_countries
      %}
    </div>
  </div>

  <div class="hikes__rows" data-rows>
    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <ul class="hikes__list" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign img_loading = 'lazy'
              assign img_priority = 'auto'
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              endif

              assign hike_start = product.metafields.custom.hike_start_date.value
              assign hike_end = product.metafields.custom.hike_end_date.value

              if product.price_varies
                assign deposit_cents = product.price_min
              else
                assign deposit_cents = product.price
              endif
              assign percent_ratio = settings.deposit_percent | divided_by: 100.0
              assign full_cents = deposit_cents | divided_by: percent_ratio | round
              assign price_amount = full_cents | money_without_trailing_zeros | remove: '.'
            -%}

            <li>
              <a class="hike-row" href="{{ product.url }}">
                <div class="hike-row__media">
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 3000
                      | image_tag:
                          widths: '750,1100,1500,2000,2600,3000',
                          sizes: '100vw',
                          loading: img_loading,
                          fetchpriority: img_priority,
                          alt: product.featured_image.alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'hike-row__placeholder' }}
                  {%- endif -%}
                </div>

                <div class="hike-row__caption">
                  <div class="hike-row__text">
                    <h2 class="hike-row__title">
                      {{- product.title -}}
                      {%- if hike_start != blank %}
                        <span class="hike-row__dates">
                          {%- render 'hike-dates', start: hike_start, end: hike_end -%}
                        </span>
                      {%- endif -%}
                    </h2>

                    <p class="hike-row__price">
                      {%- if product.price_varies -%}
                        {{ 'collections.hikes.price_from' | t: price: price_amount }}
                      {%- else -%}
                        {{ price_amount }}
                      {%- endif -%}
                    </p>
                  </div>

                  <span class="hike-row__arrow" aria-hidden="true">
                    {{- 'icon-arrow-right.svg' | inline_asset_content -}}
                  </span>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="hikes__pagination" data-pagination>
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="hikes__empty">{{ 'collections.hikes.no_results' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</hike-list>

{% stylesheet %}

  .hikes {
    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: var(--spacing-section);
  }

  .hikes > * {
    grid-column: 2;
  }

  .hikes__intro {
    --intro-gap: 1rem;

    display: flex;
    flex-direction: column;
    gap: var(--intro-gap);
    padding-block-start: var(--spacing-section);
  }

  .hikes__text {
    display: flex;
    flex-direction: column;
    gap: var(--intro-gap);
  }

  .hikes__rows {
    padding-bottom: var(--spacing-section);
  }

  @media (width >= 750px) {
    .hikes__intro {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  /* The deck is the display serif here, as in journey-rows and create-a-hike. */
  .hikes__subheading {
    font-family: var(--font-display--family);
  }

  .hikes__filters {
    position: relative;
  }

  @media (width >= 750px) {
    .hikes__filters {
      flex: 0 0 auto;
    }
  }

  .hikes__rows {
    grid-column: 1 / -1;
  }

  .hikes__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-section);
    padding: 0;
    list-style: none;
  }

  .hikes__pagination,
  .hikes__empty {
    width: var(--content-width);
    margin-inline: auto;
    padding-block: var(--spacing-section);
  }

  .hike-row {
    --row-height: min(64vw, 380px);
    --caption-inset: 1.5rem;
    --row-scrim: 0.25;
    --row-hover-wash: 0.2;

    position: relative;
    display: block;
    height: var(--row-height);
    overflow: hidden;
    color: var(--color-on-image);
    text-decoration: none;
  }

  @media (width >= 750px) {
    .hike-row {
      --row-height: 350px;
      --caption-inset: 3.5rem;
    }
  }

  .hike-row__media {
    position: absolute;
    inset: 0;
  }

  .hike-row__media img,
  .hike-row__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--easing-base);
  }

  .hike-row__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to top, rgb(0 0 0 / var(--row-scrim)) 0%, rgb(0 0 0 / 0) 65%);
    background-color: rgb(0 0 0 / 0);
    transition: background-color var(--duration-base) var(--easing-base);
  }

  .hike-row__caption {
    position: absolute;
    inset-inline: calc((100% - var(--content-width)) / 2);
    bottom: var(--caption-inset);
    display: flex;
    gap: 1.5rem;
  }

  .hike-row__title {
    font-size: var(--font-size-display-compact);
  }

  @media (width >= 750px) {
    .hike-row__title {
      font-size: var(--font-size-display);
    }
  }

  .hike-row__price {
    font-family: var(--font-display--family);
    font-size: var(--font-size-display-compact);
  }

  @media (width >= 750px) {
    .hike-row__price {
      font-size: var(--font-size-display);
    }
  }

  .hike-row__arrow {
    margin-inline-start: auto;
  }

  .hike-row__arrow svg {
    width: var(--size-icon);
    height: var(--size-icon);
    transition: transform var(--duration-base) var(--easing-base);
  }

  @media (width >= 750px) {
    .hike-row__arrow svg {
      width: 2.625rem;
      height: 2.625rem;
    }
  }

  .hike-row:hover .hike-row__media::after,
  .hike-row:focus-visible .hike-row__media::after {
    background-color: rgb(0 0 0 / var(--row-hover-wash));
  }

  .hike-row:hover .hike-row__arrow svg,
  .hike-row:focus-visible .hike-row__arrow svg {
    transform: translateX(0.375rem);
  }

  .hike-row:hover .hike-row__media img,
  .hike-row:focus-visible .hike-row__media img {
    transform: scale(1.03);
  }

  .hike-row:focus-visible {
    outline-color: var(--color-on-image);
    outline-offset: -6px;
  }

  .hikes[aria-busy='true'] .hikes__rows {
    opacity: 0.5;
    transition: opacity var(--duration-fast) var(--easing-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .hike-row__media img,
    .hike-row__media svg,
    .hike-row__media::after,
    .hike-row__arrow svg,
    .hikes[aria-busy='true'] .hikes__rows {
      transition: none;
    }

    .hike-row:hover .hike-row__arrow svg,
    .hike-row:focus-visible .hike-row__arrow svg,
    .hike-row:hover .hike-row__media img,
    .hike-row:focus-visible .hike-row__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Swaps the filter list and rows in place so choosing a country never reloads the page. */
  class HikeList extends HTMLElement {
    connectedCallback() {
      this.sectionId = this.dataset.sectionId;

      this.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;

        const link = event.target.closest('[data-filters] a, [data-pagination] a');
        if (!link) return;

        event.preventDefault();

        /* A chosen filter closes the dropdown at once; focus waits on the toggle for the new list. */
        const dropdown = link.closest('[data-filters] details');
        if (dropdown) {
          dropdown.open = false;
          dropdown.querySelector('summary')?.focus();
        }

        this.load(link.href, true);
      });

      window.addEventListener('popstate', () => this.load(window.location.href, false));
    }

    async load(url, push) {
      if (this.controller) this.controller.abort();
      this.controller = new AbortController();
      this.setAttribute('aria-busy', 'true');

      const filters = this.querySelector('[data-filters]');
      const keepFocus = Boolean(filters?.contains(document.activeElement));

      try {
        const target = new URL(url, window.location.origin);
        target.searchParams.set('section_id', this.sectionId);

        const response = await fetch(target, { signal: this.controller.signal });
        if (!response.ok) throw new Error(response.statusText);

        const markup = new DOMParser().parseFromString(await response.text(), 'text/html');

        ['[data-filters]', '[data-rows]'].forEach((selector) => {
          const next = markup.querySelector(selector);
          const current = this.querySelector(selector);
          if (next && current) current.replaceWith(next);
        });

        if (keepFocus) this.querySelector('[data-filters] summary')?.focus();

        if (push) window.history.pushState({}, '', url);
      } catch (error) {
        if (error.name !== 'AbortError') window.location.href = url;
      } finally {
        this.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('hike-list')) {
    customElements.define('hike-list', HikeList);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection_hikes",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "info": "t:info.hikes_subheading"
    }
  ]
}
{% endschema %}
