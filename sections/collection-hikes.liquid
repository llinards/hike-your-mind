{% comment %} Upcoming hike departures as image bands, soonest first. {% endcomment %}

<div class="hikes full-width">
  <div class="hikes__intro">
    <h1 class="hikes__heading">{{ collection.title }}</h1>

    {% render 'hike-features', blocks: section.blocks %}
  </div>

  <div class="hikes__rows">
    {%- comment -%}
      Shopify can't sort by a metafield, so the hikes (first 50) are ordered
      here: upcoming by soonest start, then undated. Hikes that have started are left out.
    {%- endcomment -%}
    {%- liquid
      assign today = 'now' | date: '%Y%m%d' | plus: 0
      assign sort_keys = ''

      for product in collection.products
        assign start_day = product.metafields.custom.hike_start_date.value | date: '%Y%m%d'
        assign position = forloop.index0 | prepend: '00' | slice: -3, 3

        if start_day == blank
          assign sort_key = '100000000'
        else
          assign start_number = start_day | plus: 0
          if start_number < today
            continue
          endif
          assign sort_key = start_day | prepend: '0'
        endif

        assign sort_keys = sort_keys | append: sort_key | append: '-' | append: position | append: ','
      endfor

      assign sort_keys = sort_keys | split: ',' | sort
    -%}

    {%- if sort_keys.size > 0 -%}
      <ul class="hikes__list" role="list">
        {%- for sort_key in sort_keys -%}
          {%- liquid
            assign product_index = sort_key | split: '-' | last | plus: 0
            assign product = collection.products[product_index]

            assign hike_start = product.metafields.custom.hike_start_date.value
            assign hike_end = product.metafields.custom.hike_end_date.value

            # The collection image metafield wins; the product's own photo is the fallback.
            assign row_image = product.metafields.custom.hike_collection_image.value | default: product.featured_image

            if product.price_varies
              assign deposit_cents = product.price_min
            else
              assign deposit_cents = product.price
            endif
            assign percent_ratio = settings.deposit_percent | divided_by: 100.0
            assign full_cents = deposit_cents | divided_by: percent_ratio | round
            assign price_amount = full_cents | money_without_trailing_zeros | remove: '.'
            if product.price_varies
              assign price_amount = 'collections.hikes.price_from' | t: price: price_amount
            endif
          -%}

          <li>
            {% render 'hike-row',
              url: product.url,
              title: product.title,
              image: row_image,
              start: hike_start,
              end: hike_end,
              price: price_amount,
              eager: forloop.first
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="hikes__empty">{{ 'collections.hikes.no_results' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}

  .hikes {
    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: var(--spacing-section);
  }

  .hikes > * {
    grid-column: 2;
  }

  .hikes__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block-start: var(--spacing-section);
  }

  .hikes__rows {
    padding-bottom: var(--spacing-section);
  }

  .hikes__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-section);
    padding: 0;
    list-style: none;
  }

  .hikes__empty {
    padding-block: var(--spacing-section);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_hikes",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "mountains-light.svg", "label": "t:options.icon.mountains" },
            { "value": "airplane-tilt-light.svg", "label": "t:options.icon.airplane" },
            { "value": "calendar-check-light.svg", "label": "t:options.icon.calendar" }
          ],
          "default": "mountains-light.svg"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
