{% comment %}Hiking gear as a product grid with quick add, paged without a reload.{% endcomment %}

<gear-grid class="gear" data-section-id="{{ section.id }}">
  <h1 class="gear__heading">{{ collection.title }}</h1>

  <div class="gear__results" data-results>
    <div class="gear__loader" aria-hidden="true"><span class="gear__spinner"></span></div>

    {%- paginate collection.products by 16 -%}
      {%- if collection.products.size > 0 -%}
        <ul class="gear__grid" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign variant = product.selected_or_first_available_variant | default: product.variants.first

              comment
                Colour is the option worth showing on a card; language is the fallback.
              endcomment
              assign option_kind = ''
              assign option_label = ''
              for option in product.options_with_values
                assign option_name = option.name | downcase
                if option_kind == ''
                  if option_name == 'color' or option_name == 'colour'
                    assign option_kind = 'color'
                    assign option_label = option.name
                    assign option_values = option.values
                  endif
                endif
              endfor

              if option_kind == ''
                for option in product.options_with_values
                  assign option_name = option.name | downcase
                  if option_name == 'language'
                    assign option_kind = 'language'
                    assign option_label = option.name
                    assign option_values = option.values
                  endif
                endfor
              endif

              assign pick_variant = false
              if option_kind != ''
                if product.options.size == 1
                  assign pick_variant = true
                endif
              endif

              assign quick_add = false
              if product.available
                if product.variants.size == 1
                  assign quick_add = true
                elsif pick_variant
                  assign quick_add = true
                endif
              endif

              assign on_sale = false
              if product.compare_at_price > product.price
                assign on_sale = true
              endif

              assign img_loading = 'lazy'
              if forloop.index <= 4
                assign img_loading = 'eager'
              endif

              assign compare_amount = ''
              if quick_add
                assign price_amount = variant.price | money
                if variant.compare_at_price > variant.price
                  assign compare_amount = variant.compare_at_price | money
                endif
              elsif product.price_varies
                assign price_amount = product.price_min | money
                if on_sale
                  assign compare_amount = product.compare_at_price | money
                endif
              else
                assign price_amount = product.price | money
                if on_sale
                  assign compare_amount = product.compare_at_price | money
                endif
              endif

              assign card_image = product.featured_image
              if variant.featured_image != blank
                assign card_image = variant.featured_image
              endif

              assign image_widths = '300,450,600,900,1200' | split: ','

              assign add_label = 'collections.gear.add' | t: title: product.title
              assign gallery_label = 'collections.gear.view_images' | t: title: product.title
              assign choose_label = 'collections.gear.choose' | t: title: product.title
              assign added_label = 'collections.gear.added' | t
            -%}

            {%- capture card -%}
              <div class="gear-card__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1200
                    | image_tag:
                        widths: '300,450,600,900,1200',
                        sizes: '(min-width: 1024px) 23vw, 45vw',
                        loading: img_loading,
                        alt: card_image.alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'gear-card__placeholder' }}
                {%- endif -%}

                {%- if on_sale -%}
                  <span class="gear-card__badge">{{ 'collections.gear.sale' | t }}</span>
                {%- endif -%}

                {%- if product.images.size > 0 -%}
                  <a class="gear-card__add gear-card__add--plus" href="{{ product.url }}" data-gallery>
                    {{- 'icon-plus.svg' | inline_asset_content -}}
                    <span class="visually-hidden">{{ gallery_label }}</span>
                  </a>

                  <template data-slides>
                    {%- for image in product.images -%}
                      {%- assign slide_alt = image.alt | default: product.title -%}
                      <li class="gear-lightbox__slide" data-lightbox-slide>
                        {{
                          image
                          | image_url: width: 3840
                          | image_tag:
                              widths: '1100,1600,2200,3000,3840',
                              sizes: '100vw',
                              loading: 'lazy',
                              alt: slide_alt
                        }}
                      </li>
                    {%- endfor -%}
                  </template>
                {%- endif -%}
              </div>

              <div class="gear-card__info">
                <h2 class="gear-card__title">
                  <a class="gear-card__link" href="{{ product.url }}">{{ product.title }}</a>
                </h2>

                {%- if quick_add -%}
                  <button class="gear-card__add gear-card__add--cart" type="submit">
                    {{- 'icon-cart.svg' | inline_asset_content -}}
                    <span class="visually-hidden">{{ add_label }}</span>
                  </button>
                {%- elsif product.available -%}
                  <a class="gear-card__add gear-card__add--cart" href="{{ product.url }}">
                    {{- 'icon-cart.svg' | inline_asset_content -}}
                    <span class="visually-hidden">{{ choose_label }}</span>
                  </a>
                {%- else -%}
                  <button class="gear-card__add gear-card__add--cart" type="button" disabled>
                    {{- 'icon-cart.svg' | inline_asset_content -}}
                    <span class="visually-hidden">{{ 'collections.gear.sold_out' | t }}</span>
                  </button>
                {%- endif -%}

                <p class="gear-card__price">
                  <s class="gear-card__compare" data-compare>{{ compare_amount }}</s>
                  <span data-price>
                    {%- if product.price_varies and quick_add == false -%}
                      {{ 'collections.gear.price_from' | t: price: price_amount }}
                    {%- else -%}
                      {{ price_amount }}
                    {%- endif -%}
                  </span>
                </p>

                {%- if option_kind != '' -%}
                  <div class="gear-card__options"
                    {% if pick_variant %}role="radiogroup" aria-label="{{ option_label }}"{% endif %}
                  >
                    {%- for value in option_values -%}
                      {%- liquid
                        assign value_variant = value.variant
                        assign value_compare = ''
                        if value_variant.compare_at_price > value_variant.price
                          assign value_compare = value_variant.compare_at_price | money
                        endif

                        assign value_image = value_variant.featured_image
                        if value_image == blank
                          assign value_image = product.featured_image
                        endif

                        assign value_selectable = false
                        if pick_variant
                          if value_variant != blank
                            if value.available
                              assign value_selectable = true
                            endif
                          endif
                        endif
                      -%}

                      {%- capture value_srcset -%}
                        {%- liquid
                          for width in image_widths
                            assign width_number = width | times: 1
                            echo value_image | image_url: width: width_number
                            echo ' '
                            echo width_number
                            echo 'w'
                            unless forloop.last
                              echo ', '
                            endunless
                          endfor
                        -%}
                      {%- endcapture -%}

                      {%- capture value_mark -%}
                        {%- if option_kind == 'color' and value.swatch.color -%}
                          <span class="gear-card__dot" style="--dot: {{ value.swatch.color }}"></span>
                          <span class="visually-hidden">{{ value.name }}</span>
                        {%- elsif option_kind == 'color' and value.swatch.image -%}
                          <span
                            class="gear-card__dot"
                            style="background-image: url({{ value.swatch.image | image_url: width: 40 }})"
                          ></span>
                          <span class="visually-hidden">{{ value.name }}</span>
                        {%- else -%}
                          <span class="gear-card__option-label">{{ value.name }}</span>
                        {%- endif -%}
                      {%- endcapture -%}

                      {%- if value_selectable -%}
                        <label class="gear-card__option">
                          <input
                            class="visually-hidden"
                            type="radio"
                            name="id"
                            value="{{ value_variant.id }}"
                            data-variant
                            data-price="{{ value_variant.price | money }}"
                            data-compare="{{ value_compare }}"
                            data-image="{{ value_image | image_url: width: 1200 }}"
                            data-image-srcset="{{ value_srcset | strip }}"
                            data-image-alt="{{ value_image.alt | escape }}"
                            {% if value_variant.id == variant.id %}checked{% endif %}
                          >
                          {{ value_mark }}
                        </label>
                      {%- else -%}
                        <span class="gear-card__option{% unless value.available %} is-unavailable{% endunless %}">
                          {{- value_mark -}}
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endcapture -%}

            <li class="gear-card">
              {%- if quick_add -%}
                {%- form 'product', product, class: 'gear-card__form', data-quick-add: '', data-added: added_label -%}
                  {%- unless pick_variant -%}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                  {%- endunless -%}
                  <input type="hidden" name="quantity" value="1">
                  {{ card }}
                {%- endform -%}
              {%- else -%}
                <div class="gear-card__form">{{ card }}</div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="gear__pagination" data-pagination>
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="gear__empty">{{ 'collections.gear.no_results' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>

  <p class="visually-hidden" role="status" data-status></p>

  <dialog class="gear-lightbox" aria-label="{{ 'general.accessibility.image_gallery' | t }}" scroll-lock data-lightbox>
    <ul class="gear-lightbox__track" role="list" tabindex="0" data-lightbox-track></ul>

    <p class="gear-lightbox__counter" aria-live="polite" data-counter hidden></p>

    <button class="gear-lightbox__close" type="button" data-lightbox-close>
      {{ 'icon-close.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
    </button>

    <button class="gear-lightbox__arrow gear-lightbox__arrow--previous" type="button" data-lightbox-direction="previous">
      {{ 'icon-arrow-right.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
    </button>

    <button class="gear-lightbox__arrow gear-lightbox__arrow--next" type="button" data-lightbox-direction="next">
      {{ 'icon-arrow-right.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
    </button>
  </dialog>
</gear-grid>

{% stylesheet %}
  .gear {
    --gear-columns: 2;
    --gear-sale-ink: color-mix(in oklab, var(--color-foreground) 45%, var(--color-background));
    --gear-column-gap: 1rem;
    --gear-row-gap: 2rem;

    display: flex;
    flex-direction: column;
    gap: var(--spacing-section);
    padding-block: var(--spacing-section);
  }

  @media (width >= 1024px) {
    .gear {
      --gear-columns: 4;
      --gear-column-gap: 1.75rem;
      --gear-row-gap: 2.5rem;
    }
  }

  .gear__results {
    position: relative;
  }

  .gear__grid {
    display: grid;
    grid-template-columns: repeat(var(--gear-columns), minmax(0, 1fr));
    column-gap: var(--gear-column-gap);
    row-gap: var(--gear-row-gap);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .gear-card__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .gear-card__media {
    position: relative;
    overflow: hidden;
  }

  .gear-card__media img,
  .gear-card__media svg {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform var(--duration-base) var(--easing-base), opacity var(--duration-base) var(--easing-base);
  }

  .gear-card__media img.is-swapping {
    opacity: 0;
  }

  .gear-card:hover .gear-card__media img {
    transform: scale(1.03);
  }

  .gear-card__badge {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
    padding: 0.25rem 0.625rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--font-size-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gear-card__add {
    --icon-stroke-width: 1.5;

    position: relative;
    z-index: 2;

    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .gear-card__add--plus {
    position: absolute;
    inset-block-end: 0.5rem;
    inset-inline-start: 0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .gear-card__add--plus svg {
    width: 1rem;
    height: 1rem;
  }

  .gear-card__add--cart {
    grid-column: 2;
    grid-row: 1;
    width: 1.5rem;
    height: 1.5rem;
  }

  .gear-card__add--cart svg {
    width: 100%;
    height: 100%;
  }

  .gear-card__add[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  /* The tick and the icon share one cell, so one fades in as the other fades out. */
  .gear-card__add--cart svg,
  .gear-card__add--cart::before {
    grid-area: 1 / 1;
    transition: opacity var(--duration-base) var(--easing-base), scale var(--duration-base) var(--easing-base);
  }

  .gear-card__add--cart::before {
    content: '✓';
    font-size: 1rem;
    line-height: 1;
    opacity: 0;
    scale: 0.6;
  }

  .gear-card__form.is-added .gear-card__add--cart svg {
    opacity: 0;
    scale: 0.6;
  }

  .gear-card__form.is-added .gear-card__add--cart::before {
    opacity: 1;
    scale: 1;
  }

  .gear-card__form.is-busy {
    opacity: 0.6;
  }

  .gear-card__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    align-items: start;
  }

  .gear-card__title {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--font-body--family);
    font-size: var(--font-size-small);
    font-weight: 400;
    letter-spacing: var(--letter-spacing-ui);
    line-height: var(--line-height-small);
  }

  .gear-card__link {
    color: inherit;
    text-decoration: none;
  }

  .gear-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .gear-card {
    position: relative;
  }

  .gear-card__price {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    gap: 0.5rem;
    font-size: var(--font-size-small);
  }

  /* Same muted ink as the inactive tabs on the hike product page. */
  .gear-card__compare {
    color: var(--gear-sale-ink);
  }

  .gear-card__compare:empty {
    display: none;
  }

  .gear-card__options {
    grid-column: 1;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding-block-start: 0.25rem;
  }

  .gear-card__option {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }

  .gear-card__option.is-unavailable {
    opacity: 0.35;
    cursor: default;
  }

  .gear-card__dot {
    width: 0.875rem;
    height: 0.875rem;
    border: 0.5px solid var(--color-hairline);
    border-radius: 50%;
    background-color: var(--dot, transparent);
    background-size: cover;
  }

  .gear-card__option-label {
    font-size: var(--font-size-small);
    color: var(--color-foreground-muted);
  }

  .gear-card__option:has(input:checked) .gear-card__dot {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .gear-card__option:has(input:checked) .gear-card__option-label {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gear-card__option:has(input:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .gear__pagination,
  .gear__empty {
    padding-block-start: var(--spacing-section);
  }

  /* Shopify's pagination markup may or may not carry a wrapper, so both lay the row out. */
  .gear__pagination,
  .gear__pagination .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }

  /* The page links wear the checkout button's shape, muted until hovered. */
  .gear__pagination a,
  .gear__pagination .current {
    display: block;
    padding: 0.625rem 1rem;
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--gear-sale-ink);
    color: var(--color-background);
    font-size: var(--font-size-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--duration-base) var(--easing-base);
  }

  .gear__pagination a:hover,
  .gear__pagination a:focus-visible,
  .gear__pagination .current {
    background-color: var(--color-foreground);
  }

  .gear__pagination .deco {
    color: var(--gear-sale-ink);
  }

  .gear-lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    margin: 0;
    border: 0;
    background-color: rgb(0 0 0 / 92%);
    color: var(--color-on-image);
  }

  .gear-lightbox[open] {
    animation: gear-lightbox-in var(--duration-base) var(--easing-base);
  }

  .gear-lightbox::backdrop {
    background: none;
  }

  @keyframes gear-lightbox-in {
    from {
      opacity: 0;
    }
  }

  .gear-lightbox__track {
    display: flex;
    height: 100%;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .gear-lightbox__track::-webkit-scrollbar {
    display: none;
  }

  .gear-lightbox__slide {
    flex: 0 0 100%;
    padding: 4rem 1rem;
    scroll-snap-align: start;
  }

  @media (width >= 1024px) {
    .gear-lightbox__slide {
      padding: 4rem 6rem;
    }
  }

  .gear-lightbox__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gear-lightbox__counter {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 1.25rem;
    display: flex;
    align-items: center;
    height: 3rem;
    font-size: var(--font-size-ui);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .gear-lightbox__close {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .gear-lightbox__close svg {
    width: 2rem;
    height: 2rem;
  }

  .gear-lightbox__arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .gear-lightbox__arrow--previous {
    inset-inline-start: 0.75rem;
    rotate: 180deg;
  }

  .gear-lightbox__arrow--next {
    inset-inline-end: 0.75rem;
  }

  .gear-lightbox__arrow svg {
    width: 2rem;
    height: 2rem;
    filter: drop-shadow(0 0 6px rgb(0 0 0 / 35%));
  }

  .gear-lightbox__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  /* Both are laid out with display, so hiding needs saying outright. */
  .gear-lightbox__counter[hidden],
  .gear-lightbox__arrow[hidden] {
    display: none;
  }

  .gear__loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  .gear__spinner {
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--color-hairline);
    border-block-start-color: var(--color-foreground);
    border-radius: 50%;
    animation: gear-spin 700ms linear infinite;
  }

  @keyframes gear-spin {
    to {
      rotate: 360deg;
    }
  }

  .gear[aria-busy='true'] .gear__grid,
  .gear[aria-busy='true'] .gear__pagination {
    opacity: 0.4;
  }

  .gear[aria-busy='true'] .gear__loader {
    opacity: 1;
  }

  .gear__grid,
  .gear__pagination,
  .gear__loader {
    transition: opacity var(--duration-fast) var(--easing-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .gear-card__media img,
    .gear-card__media svg {
      transition: none;
    }

    .gear-card:hover .gear-card__media img {
      transform: none;
    }

    .gear__spinner {
      display: none;
    }

    .gear__pagination a {
      transition: none;
    }

    .gear-lightbox[open] {
      animation: none;
    }

    .gear-card__add--cart svg,
    .gear-card__add--cart::before {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Pages the grid in place and adds single-variant products to the cart without leaving the page. */
  class GearGrid extends HTMLElement {
    connectedCallback() {
      this.sectionId = this.dataset.sectionId;
      this.status = this.querySelector('[data-status]');

      this.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;

        const trigger = event.target.closest('[data-gallery]');
        if (trigger) {
          event.preventDefault();
          this.openGallery(trigger);
          return;
        }

        const link = event.target.closest('[data-pagination] a');
        if (!link) return;

        event.preventDefault();
        this.load(link.href, true);
      });

      this.setupLightbox();

      this.addEventListener('change', (event) => {
        const input = event.target.closest('[data-variant]');
        if (!input) return;

        this.showPrice(input);
        this.showImage(input);
      });

      this.addEventListener('submit', (event) => {
        const form = event.target.closest('[data-quick-add]');
        if (!form) return;

        event.preventDefault();
        this.add(form);
      });

      window.addEventListener('popstate', () => this.load(window.location.href, false));
    }

    setupLightbox() {
      this.lightbox = this.querySelector('[data-lightbox]');
      if (!this.lightbox) return;

      this.track = this.lightbox.querySelector('[data-lightbox-track]');
      this.counter = this.lightbox.querySelector('[data-counter]');
      this.arrows = Array.from(this.lightbox.querySelectorAll('[data-lightbox-direction]'));

      this.track.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(this.frame);
          this.frame = requestAnimationFrame(() => this.updateGallery());
        },
        { passive: true }
      );

      this.lightbox.addEventListener('click', (event) => {
        if (event.target.closest('[data-lightbox-close]') || event.target.matches('[data-lightbox-slide]')) {
          this.lightbox.close();
          return;
        }

        const arrow = event.target.closest('[data-lightbox-direction]');
        if (arrow) this.stepGallery(arrow.dataset.lightboxDirection === 'next' ? 1 : -1);
      });

      this.lightbox.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        this.stepGallery(event.key === 'ArrowRight' ? 1 : -1);
      });

      /* The slides belong to the card, so they leave with it when the dialog closes. */
      this.lightbox.addEventListener('close', () => {
        this.track.replaceChildren();
        this.slides = [];
      });
    }

    openGallery(trigger) {
      const slides = trigger.closest('.gear-card')?.querySelector('[data-slides]');
      if (!this.lightbox || !slides) return;

      this.track.replaceChildren(slides.content.cloneNode(true));
      this.slides = Array.from(this.track.querySelectorAll('[data-lightbox-slide]'));

      this.lightbox.showModal();
      this.track.scrollTo({ left: 0, behavior: 'instant' });
      this.updateGallery();
    }

    stepGallery(step) {
      const target = this.slides[Math.min(Math.max(this.active + step, 0), this.slides.length - 1)];
      if (target) this.track.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
    }

    updateGallery() {
      if (!this.slides || this.slides.length === 0) return;

      const distance = (slide) => Math.abs(slide.offsetLeft - this.track.scrollLeft);
      this.active = this.slides.reduce(
        (nearest, slide, index) => (distance(slide) < distance(this.slides[nearest]) ? index : nearest),
        0
      );

      const many = this.slides.length > 1;

      if (this.counter) {
        this.counter.hidden = !many;
        this.counter.textContent = `${this.active + 1} / ${this.slides.length}`;
      }

      this.arrows.forEach((arrow) => {
        arrow.hidden = !many;
        arrow.disabled =
          arrow.dataset.lightboxDirection === 'next' ? this.active === this.slides.length - 1 : this.active === 0;
      });
    }

    showPrice(input) {
      const card = input.closest('.gear-card');
      const price = card?.querySelector('[data-price]');
      const compare = card?.querySelector('[data-compare]');

      if (price) price.textContent = input.dataset.price;
      if (compare) compare.textContent = input.dataset.compare;
    }

    /* The next image is decoded before the swap, so the card fades between two ready images. */
    async showImage(input) {
      const image = input.closest('.gear-card')?.querySelector('.gear-card__media img');
      if (!image || !input.dataset.image) return;
      if (image.getAttribute('src') === input.dataset.image) return;

      const next = new Image();
      next.sizes = image.sizes;
      next.srcset = input.dataset.imageSrcset;
      next.src = input.dataset.image;

      try {
        await next.decode();
      } catch (error) {
        return;
      }

      const duration = parseFloat(getComputedStyle(image).transitionDuration) * 1000 || 0;

      image.classList.add('is-swapping');

      setTimeout(() => {
        image.srcset = next.srcset;
        image.src = next.src;
        image.alt = input.dataset.imageAlt;
        image.classList.remove('is-swapping');
      }, duration);
    }

    async load(url, push) {
      if (this.controller) this.controller.abort();
      this.controller = new AbortController();
      this.setAttribute('aria-busy', 'true');

      try {
        const target = new URL(url, window.location.origin);
        target.searchParams.set('section_id', this.sectionId);

        const response = await fetch(target, { signal: this.controller.signal });
        if (!response.ok) throw new Error(response.statusText);

        const markup = new DOMParser().parseFromString(await response.text(), 'text/html');
        const next = markup.querySelector('[data-results]');
        const current = this.querySelector('[data-results]');
        if (next && current) current.replaceWith(next);

        if (push) window.history.pushState({}, '', url);

        const top = this.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top, behavior: 'smooth' });
      } catch (error) {
        if (error.name !== 'AbortError') window.location.href = url;
      } finally {
        this.removeAttribute('aria-busy');
      }
    }

    async add(form) {
      if (form.classList.contains('is-busy')) return;
      form.classList.add('is-busy');

      try {
        const root = window.Shopify?.routes?.root || '/';
        const response = await fetch(`${root}cart/add.js`, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!response.ok) throw new Error(response.statusText);

        await this.refreshCount(root);

        if (this.status) this.status.textContent = form.dataset.added;

        form.classList.add('is-added');
        clearTimeout(form.tick);
        form.tick = setTimeout(() => form.classList.remove('is-added'), 2000);
      } catch (error) {
        form.submit();
      } finally {
        form.classList.remove('is-busy');
      }
    }

    async refreshCount(root) {
      const cart = await (await fetch(`${root}cart.js`)).json();
      const link = document.querySelector('.header__cart');
      if (!link) return;

      let count = link.querySelector('.header__cart-count');

      if (!cart.item_count) {
        if (count) count.remove();
        return;
      }

      if (!count) {
        count = document.createElement('span');
        count.className = 'header__cart-count';
        count.setAttribute('aria-hidden', 'true');
        link.append(count);
      }

      count.textContent = cart.item_count;
    }
  }

  if (!customElements.get('gear-grid')) {
    customElements.define('gear-grid', GearGrid);
  }
{% endjavascript %}

