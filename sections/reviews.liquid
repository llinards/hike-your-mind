{% comment %}Customer reviews: a bordered card per review — photo beside the quote — advanced one at a time with arrow controls.{% endcomment %}

{%- liquid
  assign intro_class = 'reviews__intro'
  if section.settings.show_divider
    assign intro_class = intro_class | append: ' reviews__intro--divided'
  endif

  assign render_heading = false
  if section.settings.show_heading
    if section.settings.heading != blank
      assign render_heading = true
    endif
  endif

  assign render_subheading = false
  if section.settings.show_subheading
    if section.settings.subheading != blank
      assign render_subheading = true
    endif
  endif

  # Picked entries win; with none picked, every review entry is shown.
  assign reviews = section.settings.reviews
  if reviews == blank
    assign reviews = shop.metaobjects.review.values
  endif

  # Newest review_date first. Each key is "YYYYMMDD|handle", so a plain sort
  # orders them; undated entries get 00000000 and land last once reversed.
  assign review_keys = ''
  for review in reviews limit: 50
    assign review_day = review.review_date.value | date: '%Y%m%d'
    assign day_number = review_day | plus: 0
    if day_number < 10000000
      assign review_day = '00000000'
    endif
    assign review_keys = review_keys | append: review_day | append: '|' | append: review.system.handle | append: ','
  endfor
  assign review_keys = review_keys | split: ',' | sort | reverse

  # The modal's "Read more" is dropped once the link points at the page being
  # read, which is what makes it absent on the reviews page itself.
  assign more_link = section.settings.more_link
  if more_link != blank
    if request.path contains more_link
      assign more_link = blank
    endif
  endif

  assign has_intro = false
  if render_heading
    assign has_intro = true
  endif
  if render_subheading
    assign has_intro = true
  endif
-%}

{%- comment -%}
  The card is at most 1024px wide inside the centre column, and the
  photo takes 42% of what is left once the card's own padding (2 × 29px) is
  taken off. Keep the 158px/60px page margins in step with `settings_schema`.
{%- endcomment -%}
{%- capture image_sizes -%}
  (min-width: 750px) calc((min(1024px, 100vw - 158px) - 58px) * 0.42),
  calc(100vw - 118px)
{%- endcapture -%}

{%- if has_intro -%}
  <div class="{{ intro_class }}">
    {%- if render_heading -%}
      <h2 class="reviews__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if render_subheading -%}
      <p class="reviews__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if review_keys.size > 0 -%}
  <review-carousel class="reviews">
    <ul class="reviews__track" tabindex="0">
      {%- for review_key in review_keys -%}
        {%- liquid
          assign review_handle = review_key | split: '|' | last
          assign review = shop.metaobjects.review[review_handle]
          assign reviewer = review.reviewer_name.value
          assign photo = review.photo.value
        -%}

        <li class="reviews__item">
          <article
            class="review"
            data-review
            {% if more_link != blank %}
              data-review-more="{{ more_link }}"
            {% endif %}
          >
            {%- if photo != blank -%}
              <div class="review__media" data-review-image>
                {{
                  photo
                  | image_url: width: 1200
                  | image_tag:
                      widths: '300,400,500,600,750,900,1200',
                      sizes: image_sizes,
                      loading: 'lazy',
                      alt: photo.alt | default: reviewer
                }}
              </div>
            {%- endif -%}

            <div class="review__content">
              {%- if reviewer != blank -%}
                <h3 class="review__name" data-review-name>{{ reviewer }}</h3>
              {%- endif -%}

              <hr class="review__rule">

              {%- if review.review_text != blank -%}
                <div class="review__text" data-review-text>
                  {%- if review.review_text.type == 'rich_text_field' -%}
                    {{ review.review_text | metafield_tag }}
                  {%- else -%}
                    <p>{{ review.review_text.value | escape | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <footer class="review__footer">
                <span class="review__date" data-review-date>
                  {%- if review.review_date.type == 'date' -%}
                    {{ review.review_date.value | date: '%d.%m.%Y' }}
                  {%- else -%}
                    {{ review.review_date.value }}
                  {%- endif -%}
                </span>

                {%- comment -%}
                  The control opens the modal. It keeps its href where there is
                  one, so without JavaScript it still goes to the reviews page;
                  with no link it falls back to a button so every card keeps a
                  control the keyboard can reach.
                {%- endcomment -%}
                {%- capture more_label -%}
                  {{- 'reviews.read_more' | t -}}
                  {%- if reviewer != blank -%}
                    <span class="visually-hidden"> — {{ reviewer }}</span>
                  {%- endif -%}
                {%- endcapture -%}

                {%- if section.settings.more_link != blank -%}
                  <a class="review__more" href="{{ section.settings.more_link }}" data-review-open>
                    {{- more_label -}}
                  </a>
                {%- else -%}
                  <button class="review__more" type="button" data-review-open>
                    {{- more_label -}}
                  </button>
                {%- endif -%}
              </footer>
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>

    {%- if review_keys.size > 1 -%}
      <div class="reviews__controls">
        <button type="button" class="reviews__control" data-direction="previous">
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
        </button>
        <button type="button" class="reviews__control" data-direction="next">
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
        </button>
      </div>
    {%- endif -%}

    {%- render 'review-modal', id: section.id -%}
  </review-carousel>
{%- endif -%}

{% stylesheet %}

  .reviews__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block-start: var(--spacing-section);
  }

  .reviews__intro--divided {
    border-block-start: 0.5px solid var(--color-hairline);
    margin-block-start: var(--spacing-section);
  }

  /* The deck is the display serif here, as in content-rows and create-a-hike. */
  .reviews__subheading {
    font-family: var(--font-display--family);
  }

  .reviews {
    --card-max-width: 1024px;
    --card-height: 360px;
    --card-height-mobile: 750px;
    --inactive-opacity: 0.4;

    display: block;
    padding-block-end: var(--spacing-section);
  }

  .reviews__track {
    position: relative;
    display: flex;
    gap: 1.875rem;
    /* The 1px keeps the card's bottom hairline off the scroller's clip edge, which Safari rounds away. */
    padding: 0 0 1px;
    margin: 0;
    margin-block-start: var(--spacing-section);
    overflow-x: auto;
    list-style: none;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  .reviews__track:focus-visible {
    outline-offset: 4px;
  }

  .reviews__item {
    flex: 0 0 auto;
    width: min(var(--card-max-width), 100%);
    scroll-snap-align: start;
    transition: opacity var(--duration-base) var(--easing-base);
  }

  /* Dimming waits on the script, so a no-JS page shows every card at full ink. */
  .reviews[data-ready] .reviews__item:not(.is-active) {
    opacity: var(--inactive-opacity);
  }

  .review {
    --card-padding: 1.8125rem;

    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: var(--card-height-mobile);
    padding: var(--card-padding);
    border: 0.5px solid var(--color-ink-soft);
    color: var(--color-ink-soft);
  }

  .review__media {
    flex: 0 0 auto;
  }

  .review__media img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .review__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.9375rem;
    min-height: 0;
    font-size: var(--font-size-quote);
    line-height: 1.35;
  }

  .review__name {
    font-family: var(--font-body--family);
    font-size: var(--font-size-quote);
    font-weight: 700;
    line-height: var(--line-height-ui);
    letter-spacing: var(--letter-spacing-body);
  }

  .review__rule {
    height: 0;
    margin: 0;
    border: 0;
    border-block-start: 0.5px solid var(--color-ink-soft);
  }

  /* The card is a fixed height, so a long review is clipped and "Read more" carries it.
     The mask keeps the cut from landing halfway through a line of type. It sits over
     empty space on a short review, so only a clipped one shows the fade. */
  .review__text {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 2.5em), transparent);
  }

  /* Rich text arrives inside a .metafield-rich_text_field wrapper, so its paragraphs are spaced too. */
  .review__text > * + *,
  .review__text > .metafield-rich_text_field > * + * {
    margin-block-start: 1em;
  }

  .review__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }

  .review__date {
    opacity: 0.5;
  }

  /* The whole card opens the review, so it reads as one target. */
  .review {
    cursor: pointer;
  }

  /* The underline is drawn up front so the hover can fade its colour in.
     A review with no link renders this as a button, which needs the reset. */
  .review__more {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    white-space: nowrap;
    transition: text-decoration-color var(--duration-base) var(--easing-base);
  }

  .review__more:hover,
  .review__more:focus-visible {
    text-decoration-color: currentcolor;
  }

  .reviews__controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-block-start: var(--spacing-section);
  }

  .reviews__control {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.625rem;
    height: 2.625rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--easing-base);
  }

  .reviews__control[data-direction='previous'] {
    transform: scaleX(-1);
  }

  .reviews__control[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .reviews__control svg {
    width: 100%;
    height: 100%;
  }

  @media (width >= 750px) {
    .review {
      flex-direction: row;
      gap: var(--card-padding);
      height: var(--card-height);
    }

    .review__media {
      flex: 0 0 42%;
      align-self: stretch;
    }

    .review__media img {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews__track {
      scroll-behavior: auto;
    }

    .reviews__item {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Tracks which card the snap-scrolling track has landed on, so the rest fade back. */
  class ReviewCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.reviews__track');
      if (!this.track) return;

      this.items = Array.from(this.track.children);
      this.controls = Array.from(this.querySelectorAll('[data-direction]'));
      this.active = 0;
      this.update = this.update.bind(this);

      this.track.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(this.frame);
          this.frame = requestAnimationFrame(this.update);
        },
        { passive: true }
      );

      window.addEventListener('resize', this.update, { passive: true });

      this.addEventListener('click', (event) => {
        const control = event.target.closest('[data-direction]');
        if (!control) return;

        const step = control.dataset.direction === 'next' ? 1 : -1;
        const index = Math.min(Math.max(this.active + step, 0), this.items.length - 1);
        this.track.scrollTo({ left: this.items[index].offsetLeft });
      });

      this.update();
      this.dataset.ready = '';
    }

    update() {
      const position = this.track.scrollLeft;
      const distance = (item) => Math.abs(item.offsetLeft - position);

      this.active = this.items.reduce(
        (nearest, item, index) => (distance(item) < distance(this.items[nearest]) ? index : nearest),
        0
      );

      this.items.forEach((item, index) => item.classList.toggle('is-active', index === this.active));

      this.controls.forEach((control) => {
        control.disabled =
          control.dataset.direction === 'next' ? this.active === this.items.length - 1 : this.active === 0;
      });
    }
  }

  if (!customElements.get('review-carousel')) {
    customElements.define('review-carousel', ReviewCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What Our Clients Say About Us"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "t:labels.show_heading",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Explore reviews and stories from those who trusted us. Their satisfaction drives our innovation for better solutions."
    },
    {
      "type": "checkbox",
      "id": "show_subheading",
      "label": "t:labels.show_subheading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:labels.show_divider",
      "default": true
    },
    {
      "type": "metaobject_list",
      "id": "reviews",
      "label": "t:labels.reviews",
      "info": "t:info.reviews_selection",
      "metaobject_type": "review",
      "limit": 50
    },
    {
      "type": "url",
      "id": "more_link",
      "label": "t:labels.more_link",
      "info": "t:info.review_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.reviews"
    }
  ]
}
{% endschema %}
