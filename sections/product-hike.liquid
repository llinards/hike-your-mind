{% comment %}Hike product: a photo carousel beside the deposit reservation summary.{% endcomment %}

{%- liquid
  comment
    A sold-out departure has no available variant, so fall back to the first one
    to keep the prices on the page.
  endcomment
  assign variant = product.selected_or_first_available_variant | default: product.variants.first
  assign percent_ratio = settings.deposit_percent | divided_by: 100.0
  assign deposit_cents = variant.price
  assign full_cents = deposit_cents | divided_by: percent_ratio | round
  assign balance_cents = full_cents | minus: deposit_cents
  assign max_quantity = section.settings.max_quantity
  assign due_days = section.settings.balance_due_days

  assign hike_start = product.metafields.custom.hike_start_date.value
  assign hike_end = product.metafields.custom.hike_end_date.value
  comment
    A "list of values" metafield returns an array, a single-value one returns a
    string. Splitting on a sentinel that never occurs normalises both to an array.
  endcomment
  assign features_field = product.metafields.custom.hike_features
  assign features = features_field.value
  unless features_field.type contains 'list.'
    assign features = features_field.value | split: '~|~'
  endunless
-%}

{%- comment -%}
  Every amount scales linearly with quantity, so the money strings are rendered
  once per allowed quantity and swapped by the script. That keeps the shop's own
  money format authoritative instead of reimplementing it in JavaScript.
{%- endcomment -%}
{%- capture summary_map -%}
  {
    {%- for quantity in (1..max_quantity) -%}
      "{{ quantity }}": {
        "full": {{ full_cents | times: quantity | money_without_trailing_zeros | remove: '.' | json }},
        "deposit": {{ deposit_cents | times: quantity | money_without_trailing_zeros | remove: '.' | json }},
        "balance": {{ balance_cents | times: quantity | money_without_trailing_zeros | remove: '.' | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
{%- endcapture -%}

{%- capture deposit_price_html -%}
  <span data-summary="deposit">{{- deposit_cents | money_without_trailing_zeros | remove: '.' -}}</span>
{%- endcapture -%}

{%- capture deposit_price_static -%}
  {{- deposit_cents | money_without_trailing_zeros | remove: '.' -}}
{%- endcapture -%}

<div class="hike-product">
  <h1 class="hike-product__title">
    {{- product.title -}}
    {%- if hike_start != blank %}
      <span class="hike-product__dates">
        {%- if hike_end != blank -%}
          {{ hike_start | date: '%-d %B' }} - {{ hike_end | date: '%-d %B' }}
        {%- else -%}
          {{ hike_start | date: '%-d %B' }}
        {%- endif -%}
      </span>
    {%- endif -%}
  </h1>


  {% render 'product-gallery', product: product %}

  <hike-reservation class="hike-product__info" data-max="{{ max_quantity }}">
    <p class="hike-product__deposit">
      <span class="hike-product__deposit-lead">{{ 'product.hike.pay_today' | t }}</span>
      {{ 'product.hike.deposit_amount_html' | t: price: deposit_price_static }}
    </p>

    {%- if features.size > 0 -%}
      <ul class="hike-product__features" role="list">
        {%- for feature in features limit: 5 -%}
          <li class="hike-product__feature">{{ feature }}</li>
        {%- endfor -%}
      </ul>

      <hr class="hike-product__rule">
    {%- endif -%}

    {%- if section.settings.deposit_note != blank -%}
      <div class="hike-product__note">{{ section.settings.deposit_note }}</div>
    {%- endif -%}

    {%- form 'product', product, class: 'hike-product__form' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="return_to" value="{{ routes.cart_url }}">

      <div class="hike-product__quantity">
        <label class="hike-product__quantity-label" for="hike-quantity-{{ section.id }}">
          {{- 'product.hike.quantity' | t -}}
        </label>

        <div class="quantity">
          <button class="quantity__button" type="button" data-step="-1">
            <span aria-hidden="true">&minus;</span>
            <span class="visually-hidden">{{ 'product.hike.decrease' | t }}</span>
          </button>

          <input
            class="quantity__input"
            id="hike-quantity-{{ section.id }}"
            type="number"
            name="quantity"
            value="1"
            min="1"
            max="{{ max_quantity }}"
            step="1"
            inputmode="numeric"
            data-quantity
          >

          <button class="quantity__button" type="button" data-step="1">
            <span aria-hidden="true">+</span>
            <span class="visually-hidden">{{ 'product.hike.increase' | t }}</span>
          </button>
        </div>
      </div>

      <div class="summary">
        <h2 class="summary__title">{{ 'product.hike.summary' | t }}</h2>

        <div class="summary__row">
          <span class="summary__label">{{ 'product.hike.full_price' | t }}</span>
          <span class="summary__value" data-summary="full">
            {{- full_cents | money_without_trailing_zeros | remove: '.' -}}
          </span>
        </div>

        <div class="summary__row">
          <span class="summary__label">{{ 'product.hike.reserve' | t }}</span>
          <span class="summary__value summary__value--small">
            {{- 'product.hike.deposit_amount_html' | t: price: deposit_price_html -}}
          </span>
        </div>

        {%- if balance_cents > 0 -%}
          <div class="summary__row">
            <span class="summary__label">{{ 'product.hike.balance' | t: days: due_days }}</span>
            <span class="summary__value" data-summary="balance">
              {{- balance_cents | money_without_trailing_zeros | remove: '.' -}}
            </span>
          </div>
        {%- endif -%}

        <div class="summary__row summary__row--total">
          <span class="summary__label">{{ 'product.hike.total' | t }}</span>
          <span class="summary__value" data-summary="deposit">
            {{- deposit_cents | money_without_trailing_zeros | remove: '.' -}}
          </span>
        </div>
      </div>

      <button class="hike-product__checkout" type="submit" {% unless variant.available %}disabled{% endunless %}>
        {%- if variant.available -%}
          {{ 'product.hike.add_to_cart' | t }}
        {%- else -%}
          {{ 'product.hike.sold_out' | t }}
        {%- endif -%}
      </button>
    {%- endform -%}

    <script type="application/json" data-summary-map>{{ summary_map }}</script>
  </hike-reservation>
</div>

{% stylesheet %}
  .hike-product {
    --summary-ink: color-mix(in oklab, var(--color-foreground) 55%, var(--color-background));

    display: grid;
    gap: 1.5rem;
    padding-top: var(--spacing-section);
  }

  @media (width >= 1024px) {
    .hike-product {
      grid-template-columns: minmax(0, 54fr) minmax(0, 42fr);
      grid-template-areas:
        'title title'
        'gallery info';
      column-gap: var(--spacing-section);
      align-items: start;
    }

    .hike-product__title {
      grid-area: title;
    }

    .product-gallery {
      grid-area: gallery;
    }

    .hike-product__info {
      grid-area: info;
    }
  }

  /* The heading moves beside the gallery once the column is wide enough to hold it. */
  @media (width >= 1280px) {
    .hike-product {
      grid-template-areas:
        'gallery title'
        'gallery info';
      grid-template-rows: auto 1fr;
    }
  }

  /* create-a-hike's bare `h1` rule is theme-wide, so the heading step is set back here. */
  .hike-product__title {
    font-size: var(--font-size-display);
  }

  @media (width >= 1280px) {
    .hike-product__title {
      text-wrap: balance;
    }
  }

  .hike-product__dates::before {
    content: ' ';
  }

  /* Reservation column */

  .hike-product__info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .hike-product__deposit {
    font-family: var(--font-display--family);
    font-size: var(--font-size-display-compact);
    line-height: 1.1;
    letter-spacing: var(--letter-spacing-display);
  }

  @media (width >= 1024px) {
    .hike-product__deposit {
      font-size: 1.75rem;
    }
  }

  .hike-product__features {
    padding: 0;
    margin: 0;
    font-family: var(--font-display--family);
    list-style: none;
  }

  .hike-product__feature {
    line-height: 1.45;
  }

  @media (width < 1024px) {
    .hike-product__features {
      padding-inline-start: 1.5rem;
      list-style: disc;
    }
    
    .hike-product {
      padding-bottom: var(--spacing-section);
    }
  }

  @media (width >= 1024px) {
    .hike-product__features {
      display: flex;
      flex-wrap: wrap;
      column-gap: 0.5rem;
    }

    .hike-product__feature + .hike-product__feature::before {
      content: '|';
      margin-inline-end: 0.5rem;
      color: var(--summary-ink);
    }
  }

  .hike-product__rule {
    border: 0;
    border-block-start: 0.5px solid var(--color-hairline);
  }

  @media (width >= 1024px) {
    /* Desktop runs the features straight into the note, so the rule is mobile-only. */
    .hike-product__rule {
      display: none;
    }

    .hike-product__info {
      gap: 1.5rem;
    }

    .hike-product__rule + .hike-product__note {
      margin-block-start: -1.5rem;
    }
  }

  .hike-product__note {
    font-family: var(--font-display--family);
    line-height: 1.45;
  }

  .hike-product__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hike-product__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: start;
  }

  .hike-product__quantity-label {
    font-size: var(--font-size-small);
    color: var(--summary-ink);
  }

  .quantity {
    display: flex;
    align-items: center;
    border: 0.5px solid var(--color-hairline);
    border-radius: var(--style-border-radius-inputs);
  }

  .quantity__button {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .quantity__button[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .quantity__input {
    width: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--font-size-ui);
    text-align: center;
    appearance: textfield;
  }

  .quantity__input::-webkit-outer-spin-button,
  .quantity__input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--font-size-body);
    color: var(--summary-ink);
  }

  .summary__title {
    font-family: var(--font-body--family);
    font-size: var(--font-size-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: var(--line-height-small);
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .summary__row {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
  }

  .summary__label {
    font-size: var(--font-size-body);
  }

  .summary__value {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  /* The amount and the word "deposit" share one span, so they stay on one step. */
  .summary__value--small {
    font-size: var(--font-size-body);
  }

  .summary__row--total {
    padding-block-start: 1rem;
    border-block-start: 0.5px solid var(--color-hairline);
    font-weight: 700;
    color: var(--color-foreground);
  }

  .hike-product__checkout {
    padding: 1rem;
    border: 0;
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-family: inherit;
    font-size: var(--font-size-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity var(--duration-base) var(--easing-base);
  }

  .hike-product__checkout:hover,
  .hike-product__checkout:focus-visible {
    opacity: 0.85;
  }

  .hike-product__checkout[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .hike-product__checkout {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Swaps in the money strings Liquid pre-rendered for each quantity. */
  class HikeReservation extends HTMLElement {
    connectedCallback() {
      this.input = this.querySelector('[data-quantity]');
      if (!this.input) return;

      this.max = Number(this.dataset.max) || 10;
      this.steps = Array.from(this.querySelectorAll('[data-step]'));
      this.amounts = Array.from(this.querySelectorAll('[data-summary]'));

      const map = this.querySelector('[data-summary-map]');
      try {
        this.prices = map ? JSON.parse(map.textContent) : {};
      } catch (error) {
        this.prices = {};
      }

      this.addEventListener('click', (event) => {
        const step = event.target.closest('[data-step]');
        if (step) this.setQuantity(this.quantity() + Number(step.dataset.step));
      });

      this.input.addEventListener('change', () => this.setQuantity(this.quantity()));

      this.render();
    }

    quantity() {
      return Math.round(Number(this.input.value)) || 1;
    }

    setQuantity(value) {
      this.input.value = Math.min(Math.max(value, 1), this.max);
      this.render();
    }

    render() {
      const quantity = this.quantity();
      const prices = this.prices[quantity];

      this.steps.forEach((step) => {
        step.disabled = Number(step.dataset.step) < 0 ? quantity <= 1 : quantity >= this.max;
      });

      if (!prices) return;

      this.amounts.forEach((amount) => {
        const value = prices[amount.dataset.summary];
        if (value) amount.textContent = value;
      });
    }
  }

  if (!customElements.get('hike-reservation')) customElements.define('hike-reservation', HikeReservation);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product_hike",
  "settings": [
    {
      "type": "range",
      "id": "balance_due_days",
      "label": "t:labels.balance_due_days",
      "info": "t:info.balance_due_days",
      "min": 10,
      "max": 180,
      "step": 5,
      "unit": "d",
      "default": 60
    },
    {
      "type": "richtext",
      "id": "deposit_note",
      "label": "t:labels.deposit_note",
      "info": "t:info.deposit_note",
      "default": "<p>Your deposit secures your place. The remaining balance is due 60 days before the trip.</p>"
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "t:labels.max_quantity",
      "info": "t:info.max_quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
