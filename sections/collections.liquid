{% comment %} Collection list: a centred heading over image cards, three across on desktop. {% endcomment %}

<h1 class="collections__heading">{{ 'collections.title' | t }}</h1>

<div class="collections" style="--grid-gap: {{ section.settings.grid_gap }}px">
  {%- for collection in collections -%}
    {%- comment -%} Shopify's built-in Home page collection is not a category. {%- endcomment -%}
    {%- if collection.handle == 'frontpage' -%}
      {%- continue -%}
    {%- endif -%}

    <a class="collection-card" href="{{ collection.url }}">
      <div class="collection-card__media">
        {%- if collection.featured_image != blank -%}
          {{
            collection.featured_image
            | image_url: width: 1500
            | image_tag:
                widths: '400,600,800,1000,1200,1500',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                loading: 'lazy',
                alt: collection.featured_image.alt
          }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
        {%- endif -%}
      </div>

      <div class="collection-card__caption">
        <h2 class="collection-card__title">{{ collection.title }}</h2>

        <span class="collection-card__arrow" aria-hidden="true">
          {{- 'icon-arrow-right.svg' | inline_asset_content -}}
        </span>
      </div>
    </a>
  {%- endfor -%}
</div>

{% stylesheet %}
  .collections__heading {
    padding-block: var(--spacing-section);
    text-align: center;
  }

  .collections {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-gap);
    padding-block-end: var(--spacing-section);
  }

  @media (width >= 750px) {
    .collections {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width >= 990px) {
    .collections {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .collection-card {
    --caption-inset: 1.5rem;
    --card-scrim: 0.25;
    --card-hover-wash: 0.2;

    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    color: var(--color-on-image);
    text-decoration: none;
  }

  @media (width >= 750px) {
    .collection-card {
      --caption-inset: 2rem;
    }
  }

  .collection-card__media {
    position: absolute;
    inset: 0;
  }

  .collection-card__media img,
  .collection-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--easing-base);
  }

  .collection-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to top, rgb(0 0 0 / var(--card-scrim)) 0%, rgb(0 0 0 / 0) 65%);
    background-color: rgb(0 0 0 / 0);
    transition: background-color var(--duration-base) var(--easing-base);
  }

  .collection-card__caption {
    position: absolute;
    inset-inline: var(--caption-inset);
    bottom: var(--caption-inset);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .collection-card__title {
    font-size: var(--font-size-display-compact);
  }

  .collection-card__arrow {
    flex-shrink: 0;
  }

  .collection-card__arrow svg {
    width: var(--size-icon);
    height: var(--size-icon);
    transition: transform var(--duration-base) var(--easing-base);
  }

  .collection-card:hover .collection-card__media::after,
  .collection-card:focus-visible .collection-card__media::after {
    background-color: rgb(0 0 0 / var(--card-hover-wash));
  }

  .collection-card:hover .collection-card__arrow svg,
  .collection-card:focus-visible .collection-card__arrow svg {
    transform: translateX(0.375rem);
  }

  .collection-card:hover .collection-card__media img,
  .collection-card:focus-visible .collection-card__media img {
    transform: scale(1.03);
  }

  .collection-card:focus-visible {
    outline-color: var(--color-on-image);
    outline-offset: -6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-card__media img,
    .collection-card__media svg,
    .collection-card__media::after,
    .collection-card__arrow svg {
      transition: none;
    }

    .collection-card:hover .collection-card__arrow svg,
    .collection-card:focus-visible .collection-card__arrow svg,
    .collection-card:hover .collection-card__media img,
    .collection-card:focus-visible .collection-card__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
