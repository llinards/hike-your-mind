{%- liquid
  assign intro_class = 'create-a-hike__intro'
  if section.settings.show_divider
    assign intro_class = intro_class | append: ' create-a-hike__intro--divided'
  endif
  assign has_intro = false
  if section.settings.heading != blank
    assign has_intro = true
  endif
  if section.settings.subheading != blank
    assign has_intro = true
  endif
-%}

{%- if has_intro -%}
  <div class="{{ intro_class }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="create-a-hike__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="create-a-hike__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if section.settings.image != blank -%}
  {%- comment -%}
    The image is in the centre column, not full-bleed, so `sizes` describes that
    column rather than the viewport. The numbers are the rendered width of
    `--content-width`: the page is 90rem wide with a 79px margin either side
    (30px below 750px), so the column stops growing at 1440 - 158 = 1282px once
    the viewport passes 1598px. Keep them in step with the layout settings in
    `config/settings_schema.json`.
  {%- endcomment -%}
  <div class="create-a-hike__image" style="--image-position: {{ section.settings.image_position }}%;">
    {{
      section.settings.image
      | image_url: width: 2600
      | image_tag:
          widths: '400,600,750,1100,1500,2000,2600',
          sizes: '(min-width: 1598px) 1282px, (min-width: 750px) calc(100vw - 158px), calc(100vw - 60px)',
          loading: 'lazy',
          alt: section.settings.image.alt
    }}
  </div>
{%- endif -%}

{%- if section.settings.paragraph != blank -%}
  <p class="create-a-hike__paragraph">{{ section.settings.paragraph }}</p>
{%- endif -%}

{%- if section.settings.cta_label != blank -%}
  <a class="create-a-hike__cta" href="{{ section.settings.cta_link  }}">
    {%- comment -%}
      The label is its own element so the hover underline stops at the text —
      run it across the anchor and the rule carries on under the arrow.
    {%- endcomment -%}
    <span class="create-a-hike__cta-label">{{ section.settings.cta_label }}</span>
    {{ 'icon-arrow-right.svg' | inline_asset_content }}
  </a>
{%- endif -%}

{% stylesheet %}
  /**
   * Same 0.5px hairline the header, footer and journey rows use. The space
   * above it is margin and the space below it padding, so the rule sits nearer
   * the heading it introduces than the section it separates from.
   */
  .create-a-hike__intro {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: var(--spacing-section);
  }

  .create-a-hike__intro--divided {
    border-block-start: 0.5px solid var(--color-hairline);
    margin-block-start: 3rem;
    padding-block-start: 2rem;
  }

  /* The deck is the display serif here, not the body sans — see the design. */
  .create-a-hike__subheading {
    font-family: var(--font-display--family);
  }

  /**
   * A letterbox crop: the design runs the photograph as a wide band across the
   * column. Held to 4:3 on a phone, where 2.7:1 would leave a sliver.
   */
  .create-a-hike__image {
    aspect-ratio: 4 / 3;
  }

  /**
   * `cover` already centres the crop; the setting exists because a photograph
   * whose subject sits high or low in the frame needs to be pulled that way by
   * hand, and a 2.7:1 band throws most of the frame away.
   *
   * The percentage is the vertical focal point: 0% holds the top edge of the
   * photograph against the top of the band, 100% the bottom edge against the
   * bottom. Horizontal stays centred — the band is as wide as the column, so
   * there is nothing to choose along that axis.
   */
  .create-a-hike__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--image-position, 50%);
  }

  @media (width >= 750px) {
    .create-a-hike__image {
      aspect-ratio: 2.7;
    }
  }

  .create-a-hike__paragraph {
    max-width: 72ch;
    padding-block: var(--spacing-section);
    font-family: var(--font-display--family);
    font-size: var(--font-size-lead);
    line-height: var(--line-height-lead);
  }

  /**
   * The call to action sits on its own line, hard right — in the design it
   * clears the paragraph's last line rather than sitting beside it.
   */
  .create-a-hike__cta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-block-end: var(--spacing-section);
    color: inherit;
    font-family: var(--font-display--family);
    text-decoration: none;
  }

  .create-a-hike__cta svg {
    width: var(--size-icon);
    height: var(--size-icon);
    transition: transform var(--duration-base) var(--easing-base);
  }

  .create-a-hike__cta:hover .create-a-hike__cta-label,
  .create-a-hike__cta:focus-visible .create-a-hike__cta-label {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .create-a-hike__cta:hover svg,
  .create-a-hike__cta:focus-visible svg {
    transform: translateX(0.375rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .create-a-hike__cta svg {
      transition: none;
    }

    .create-a-hike__cta:hover svg,
    .create-a-hike__cta:focus-visible svg {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.create_a_hike",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Create a Hike With Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Have an idea for a special hiking experience?"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:labels.show_divider",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "range",
      "id": "image_position",
      "label": "t:labels.image_position",
      "info": "t:info.image_position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "paragraph",
      "label": "t:labels.paragraph",
      "default": "Bring your activity, theme and people — HIKE YOUR MIND will take care of the route and practical planning."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Create a Hike With Us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.create_a_hike"
    }
  ]
}
{% endschema %}
