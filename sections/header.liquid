{% comment %}
  Site header.

  Desktop is two rows, as in the design: the wordmark, language switcher and
  utility icons on top, the main navigation underneath. Both the language
  switcher and the navigation start at the same inline offset from the content
  edge (`--header-inset`, 340px - 79px in the 1440px design).

  Mobile collapses to a single row with a hamburger that opens a <details>
  drawer holding the navigation and language switcher. `scroll-lock` is picked
  up by critical.css to stop the page scrolling behind the open drawer.

  Opening, closing and the hamburger's fold into an X are all CSS off the
  `[open]` attribute; the only JavaScript is `header-drawer`, which delays the
  close so the panel can animate out first. Without it the drawer still works,
  it just shuts instantly.
{% endcomment %}

<header class="header full-width">
  <div class="header__row">
    <a
      class="header__logo"
      href="{{ routes.root_url }}"
      {% if request.page_type == 'index' %}
        aria-current="page"
      {% endif %}
    >
      {{ 'logo-wordmark.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ shop.name }}</span>
    </a>

    <nav class="header__nav" aria-label="{{ 'general.accessibility.primary_navigation' | t }}">
      {% render 'nav-menu', menu: section.settings.menu %}
    </nav>

    <div class="header__utils">
      {% for link in section.settings.utility_menu.links %}
        <a class="header__utility-link" href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          <span class="header__icon" slot="signed-out-avatar">
            {{ 'icon-user.svg' | inline_asset_content }}
            <span class="visually-hidden">{{ 'general.accessibility.account' | t }}</span>
          </span>
        </shopify-account>
      {% endif %}

      <a class="header__icon header__cart" href="{{ routes.cart_url }}">
        {{ 'icon-bag.svg' | inline_asset_content }}
        <span class="visually-hidden">{{ 'general.accessibility.cart' | t }}</span>
        {% if cart.item_count > 0 %}
          <span class="header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      {% render 'language-selector', class: 'header__language' %}

      <header-drawer>
        <details class="header__drawer" scroll-lock>
          <summary class="header__icon header__drawer-toggle">
            {{ 'icon-menu.svg' | inline_asset_content }}
            <span class="visually-hidden">{{ 'general.accessibility.menu' | t }}</span>
          </summary>

          <div class="header__drawer-panel">
            {% render 'nav-menu', menu: section.settings.menu, class: 'nav-menu--stacked' %}
            {% render 'language-selector' %}
          </div>
        </details>
      </header-drawer>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    --header-inset: 0px;

    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: 3.5rem;
    padding-block: 2.4375rem 0;
    color: var(--color-foreground);
  }

  .header > * {
    grid-column: 2;
  }

  .header__row {
    display: flex;
    align-items: center;
  }

  .header__logo {
    display: block;
    width: 8.6875rem;
    color: var(--color-foreground);
  }

  .header__logo svg {
    width: 100%;
    height: auto;
  }

  /* Pushes the utility cluster to the far end of the row. */
  .header__utils {
    display: flex;
    align-items: center;
    gap: 1.875rem;
    margin-inline-start: auto;
  }

  .header__utility-link {
    color: var(--color-foreground);
    font-size: var(--font-size-ui);
    line-height: var(--line-height-ui);
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  .header__utility-link:hover {
    text-decoration: underline;
  }

  .header__icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-icon);
    height: var(--size-icon);
    color: var(--color-foreground);
    cursor: pointer;
  }

  .header__icon svg {
    width: 100%;
    height: 100%;
  }

  shopify-account {
    --shopify-account-avatar-size: var(--size-icon);
    --shopify-account-signed-in-avatar-size: var(--size-icon);

    display: flex;
    align-items: center;
  }

  shopify-account::part(signed-out-avatar) {
    padding: 0;
    border: none;
    background: none;
    color: var(--color-foreground);
  }

  .header__cart-count {
    position: absolute;
    inset-block-start: -0.25rem;
    inset-inline-start: 100%;
    font-size: var(--font-size-small);
    line-height: 1;
  }

  header-drawer {
    display: contents;
  }

  .header__drawer-toggle {
    list-style: none;
  }

  .header__drawer-toggle::-webkit-details-marker {
    display: none;
  }

  .header__drawer-toggle svg {
    width: 1.6875rem;
    height: auto;
  }

  /**
   * The hamburger folds into an X while the drawer is open. The bars are the
   * three paths of `icon-menu.svg`, and `view-box` puts their transform origin
   * at the centre of the icon (13.5, 8.2 in user units).
   *
   * Order matters: transforms apply right to left, so the rotation must be
   * written first for the bar to be moved onto the centre line and only then
   * turned about it. Rotating first swings each bar around the centre while it
   * still sits 7.75 units away, and the arms end up 4.5px apart — an X that
   * crosses off its own middle.
   */
  .icon-menu__bar {
    transform-box: view-box;
    transform-origin: center;
    transition:
      transform var(--duration-base) var(--easing-base),
      opacity var(--duration-fast) var(--easing-base);
  }

  .header__drawer[open]:not([data-closing]) .icon-menu__bar--top {
    transform: rotate(45deg) translateY(7.75px);
  }

  .header__drawer[open]:not([data-closing]) .icon-menu__bar--middle {
    opacity: 0;
  }

  .header__drawer[open]:not([data-closing]) .icon-menu__bar--bottom {
    transform: rotate(-45deg) translateY(-7.75px);
  }

  .header__drawer-panel {
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem var(--page-margin);
    background-color: var(--color-background);
    border-block-end: 0.5px solid var(--color-hairline);
  }

  /**
   * Animations rather than transitions: a closed <details> hides its panel
   * outright, so there is no start state for a transition to run from.
   *
   * Both are hung off the attributes rather than the panel itself, because the
   * panel element survives a close. An animation on the panel's own rule stays
   * applied and finished, so it plays once and never again; letting the
   * selector stop matching cancels it, and re-matching starts it over.
   */
  .header__drawer[open] .header__drawer-panel {
    animation: header-drawer-open var(--duration-base) var(--easing-base);
  }

  /* `header-drawer` holds the drawer open while this one runs. */
  .header__drawer[open][data-closing] .header__drawer-panel {
    animation: header-drawer-close var(--duration-base) var(--easing-base) forwards;
  }

  @keyframes header-drawer-open {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }

  @keyframes header-drawer-close {
    to {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }

  .nav-menu--stacked {
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Mobile: the drawer carries navigation and language, so both rows collapse. */
  .header__nav,
  .header__language {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-menu__bar {
      transition: none;
    }

    .header__drawer[open] .header__drawer-panel,
    .header__drawer[open][data-closing] .header__drawer-panel {
      animation: none;
    }
  }

  @media (width >= 1140px) {
    .header {
      /* 340px - 79px in the 1440px design: language and nav share this offset. */
      --header-inset: 16.3125rem;
    }

    /**
     * The inset is measured from the content edge, not from the logo, so the
     * language switcher lines up with the navigation row beneath it. A grid
     * column of exactly `--header-inset` does that; a flex gap would measure
     * from the end of the logo instead.
     */
    .header__row {
      display: grid;
      grid-template-columns: var(--header-inset) auto 1fr;
      align-items: center;
    }

    .header__nav,
    .header__language {
      display: block;
    }

    .header__drawer {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Holds a closing <details> open until its panel has animated out. Without
   * this the browser tears the panel down on the click and the close is
   * instant; opening needs no help, as the panel animates in off `[open]`.
   */
  class HeaderDrawer extends HTMLElement {
    connectedCallback() {
      const details = this.querySelector('details');
      if (!details) return;

      const summary = details.querySelector('summary');
      const panel = details.querySelector('.header__drawer-panel');
      if (!summary || !panel) return;

      summary.addEventListener('click', (event) => {
        if (!details.open) return;

        event.preventDefault();

        /* No animation runs under reduced motion, so there would be no
           animationend to wait for. */
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          details.open = false;
          return;
        }

        if (details.hasAttribute('data-closing')) return;

        const close = (animation) => {
          if (animation.target !== panel) return;
          panel.removeEventListener('animationend', close);
          details.removeAttribute('data-closing');
          details.open = false;
        };

        panel.addEventListener('animationend', close);
        details.setAttribute('data-closing', '');
      });
    }
  }

  if (!customElements.get('header-drawer')) {
    customElements.define('header-drawer', HeaderDrawer);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "t:labels.utility_menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
