{% comment %}
  Site footer. Three rows on desktop — wordmark opposite the Instagram call-out,
  then tagline / contacts / menu / company details across four columns, then the
  copyright. On phones everything stacks and the Instagram call-out drops to
  second from last, as in the design.
{% endcomment %}

{%- liquid
  # A filter chain cannot be used inline as a `t:` argument, so the year is
  # resolved first.
  assign current_year = 'now' | date: '%Y'
-%}

<footer class="footer full-width">
  <div class="footer__inner">
    <div class="footer__wordmark">
      {{ 'logo-wordmark-large.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ shop.name }}</span>
    </div>

    {%- if section.settings.instagram_url != blank -%}
      <a class="footer__instagram" href="{{ section.settings.instagram_url }}">
        <span class="footer__instagram-label">{{ 'general.social.follow_instagram' | t }}</span>
        <span class="footer__instagram-icon">
          {{- 'icon-instagram.svg' | inline_asset_content -}}
        </span>
      </a>
    {%- endif -%}

    {%- if section.settings.tagline != blank -%}
      <p class="footer__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}

    {%- if section.settings.contact_details != blank -%}
      <div class="footer__column footer__column--contacts">
        <h2 class="footer__column-title">{{ 'general.footer.contacts' | t }}</h2>
        {{ section.settings.contact_details }}
      </div>
    {%- endif -%}

    {%- if section.settings.menu != blank -%}
      <nav class="footer__column footer__column--menu" aria-label="{{ 'general.footer.menu' | t }}">
        <h2 class="footer__column-title">{{ 'general.footer.menu' | t }}</h2>
        <ul class="footer__list">
          {%- for link in section.settings.menu.links -%}
            <li><a class="footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if section.settings.company_details != blank -%}
      <div class="footer__column footer__column--company">
        <h2 class="footer__column-title">{{ 'general.footer.company_details' | t }}</h2>
        {{ section.settings.company_details }}
      </div>
    {%- endif -%}

    <p class="footer__copyright">
      {%- if section.settings.copyright != blank -%}
        {{ section.settings.copyright }}
      {%- else -%}
        {{ 'general.footer.copyright' | t: year: current_year, shop_name: shop.name }}
      {%- endif -%}
    </p>
  </div>
</footer>

{% stylesheet %}
  .footer {
    display: grid;
    grid-template-columns: var(--content-grid);
    border-block-start: 0.5px solid var(--color-hairline);
    color: var(--color-foreground-muted);
  }

  .footer__inner {
    display: grid;
    grid-column: 2;
    row-gap: 2.5rem;
    padding-block: 2.625rem;
  }

  /* On phones the call-out leaves the wordmark and drops in above the copyright. */
  .footer__instagram {
    order: 1;
  }

  .footer__copyright {
    order: 2;
  }

  .footer__wordmark {
    width: min(31.0625rem, 100%);
    color: var(--color-foreground-muted);
  }

  .footer__wordmark svg {
    width: 100%;
    height: auto;
  }

  .footer__instagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  /* The two large lines in the footer are the body sans, not the display serif. */
  .footer__instagram-label,
  .footer__tagline {
    font-size: var(--font-size-display-compact);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
  }

  .footer__tagline {
    color: var(--color-foreground);
  }

  .footer__instagram-icon {
    flex-shrink: 0;
    width: var(--size-icon);
    height: var(--size-icon);
  }

  .footer__instagram-icon svg {
    width: 100%;
    height: 100%;
  }

  .footer__column {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* The column headings sit at body size in the design, not as headings. */
  .footer__column-title,
  .footer__link,
  .footer__column :where(p) {
    font-family: var(--font-body--family);
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: var(--line-height-body);
    letter-spacing: var(--letter-spacing-body);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer__link {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  .footer__link:hover {
    text-decoration: underline;
  }

  .footer__copyright {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    letter-spacing: var(--letter-spacing-small);
    text-align: center;
  }

  /* Tablets take the wordmark row and the three detail columns, but the tagline
     still needs the full width — four across only fits once there is room for it. */
  @media (width >= 750px) {
    .footer__inner {
      /* The `min-content` floors keep an email address or a registration number
         from being broken across two lines when the tracks get narrow. */
      grid-template-columns:
        minmax(min-content, 1.4fr)
        minmax(min-content, 1fr)
        minmax(min-content, 1.4fr);
      grid-template-areas:
        'brand    brand   social'
        'tagline  tagline tagline'
        'contacts menu    company'
        'legal    legal   legal';
      column-gap: 1.5rem;
    }

    .footer__wordmark {
      grid-area: brand;
    }

    .footer__instagram {
      grid-area: social;
      align-self: center;
      justify-self: end;
    }

    /* The design opens a wide band between the wordmark row and what follows. */
    .footer__tagline {
      grid-area: tagline;
      margin-block-start: 4.5rem;
      font-size: var(--font-size-display);
    }

    .footer__column--contacts {
      grid-area: contacts;
    }

    .footer__column--menu {
      grid-area: menu;
    }

    .footer__column--company {
      grid-area: company;
    }

    .footer__copyright {
      grid-area: legal;
      text-align: left;
    }
  }

  /* The design's four-across row. The detail columns take the width their own
     content asks for and the tagline keeps whatever is left. */
  @media (width >= 1280px) {
    .footer__inner {
      grid-template-columns: minmax(20rem, 1fr) auto auto auto;
      grid-template-areas:
        'brand   brand    social social'
        'tagline contacts menu   company'
        'legal   legal    legal  legal';
      column-gap: 3.5rem;
    }

    .footer__inner > .footer__column {
      margin-block-start: 4.5rem;
    }

    /* Only here is the brand row wide enough to hold the call-out on one line. */
    .footer__instagram-label {
      font-size: var(--font-size-display);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "Feel Free to Contact Us & Remember to Hike Your Mind!"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:labels.instagram_url"
    },
    {
      "type": "richtext",
      "id": "contact_details",
      "label": "t:labels.contact_details"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "richtext",
      "id": "company_details",
      "label": "t:labels.company_details"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:labels.copyright",
      "info": "t:info.copyright"
    }
  ]
}
{% endschema %}
