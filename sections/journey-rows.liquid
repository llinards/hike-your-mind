{% comment %} The three ways into the store: an intro over full-bleed image bands, one per row block. {% endcomment %}

{%- liquid
  assign intro_class = 'journey-rows__intro'
  if section.settings.show_divider
    assign intro_class = intro_class | append: ' journey-rows__intro--divided'
  endif

  assign has_intro = false
  if section.settings.heading != blank
    assign has_intro = true
  endif
  if section.settings.subheading != blank
    assign has_intro = true
  endif
-%}

{%- if has_intro -%}
  <div class="{{ intro_class }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="journey-rows__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="journey-rows__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="journey-rows full-width"
    style="--row-height-desktop: {{ section.settings.row_height }}px; --row-gap: {{ section.settings.row_gap }}px;"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign wrapper = 'div'
        if block.settings.link != blank
          assign wrapper = 'a'
        endif

        assign img_loading = 'lazy'
        assign img_priority = 'auto'
        if forloop.first
          assign img_loading = 'eager'
          assign img_priority = 'high'
        endif
      -%}

      <{{ wrapper }}
        class="journey-row"
        {% if wrapper == 'a' %}href="{{ block.settings.link }}"{% endif %}
        style="--image-position: {{ block.settings.image_position }}%;"
        {{ block.shopify_attributes }}
      >
        <div class="journey-row__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 3000
              | image_tag:
                  widths: '750,1100,1500,2000,2600,3000',
                  sizes: '100vw',
                  loading: img_loading,
                  fetchpriority: img_priority,
                  alt: block.settings.image.alt
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'journey-row__placeholder' }}
          {%- endif -%}
        </div>

        <div class="journey-row__caption">
          {%- if block.settings.title != blank -%}
            <h3 class="journey-row__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          <span class="journey-row__arrow" aria-hidden="true">
            {{- 'icon-arrow-right.svg' | inline_asset_content -}}
          </span>
        </div>
      </{{ wrapper }}>
    {%- endfor -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .journey-rows__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: var(--spacing-section);
  }

  /* The deck is the display serif here, not the body sans — as in create-a-hike. */
  .journey-rows__subheading {
    font-family: var(--font-display--family);
  }

  .journey-rows__intro--divided {
    border-block-start: 0.5px solid var(--color-hairline);
    margin-block-start: var(--spacing-section);
  }

  .journey-rows {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
  }

  .journey-row {
    --row-height: min(56vw, 320px);
    --caption-inset: 1.5rem;
    --row-scrim: 0.25;
    --row-hover-wash: 0.2;

    position: relative;
    display: block;
    height: var(--row-height);
    overflow: hidden;
    color: var(--color-on-image);
    text-decoration: none;
  }

  @media (width >= 750px) {
    .journey-row {
      --row-height: var(--row-height-desktop);
      --caption-inset: 3.5rem;
    }
  }

  .journey-row__media {
    position: absolute;
    inset: 0;
  }

  .journey-row__media img,
  .journey-row__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--image-position, 50%);
    transition: transform var(--duration-base) var(--easing-base);
  }

  .journey-row__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to top, rgb(0 0 0 / var(--row-scrim)) 0%, rgb(0 0 0 / 0) 65%);
    background-color: rgb(0 0 0 / 0);
    transition: background-color var(--duration-base) var(--easing-base);
  }

  .journey-row__caption {
    position: absolute;
    inset-inline: calc((100% - var(--content-width)) / 2);
    bottom: var(--caption-inset);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .journey-row__title {
    font-size: var(--font-size-display-compact);
  }

  @media (width >= 750px) {
    .journey-row__title {
      font-size: var(--font-size-display);
    }
  }

  .journey-row__arrow {
    margin-inline-start: auto;
  }

  .journey-row__arrow svg {
    width: var(--size-icon);
    height: var(--size-icon);
    transition: transform var(--duration-base) var(--easing-base);
  }

  @media (width >= 750px) {
    .journey-row__arrow svg {
      width: 2.625rem;
      height: 2.625rem;
    }
  }

  a.journey-row:hover .journey-row__media::after,
  a.journey-row:focus-visible .journey-row__media::after {
    background-color: rgb(0 0 0 / var(--row-hover-wash));
  }

  a.journey-row:hover .journey-row__arrow svg,
  a.journey-row:focus-visible .journey-row__arrow svg {
    transform: translateX(0.375rem);
  }

  a.journey-row:hover .journey-row__media img,
  a.journey-row:focus-visible .journey-row__media img {
    transform: scale(1.03);
  }

  .journey-row:focus-visible {
    outline-color: var(--color-on-image);
    outline-offset: -6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-row__media img,
    .journey-row__media svg,
    .journey-row__media::after,
    .journey-row__arrow svg {
      transition: none;
    }

    a.journey-row:hover .journey-row__arrow svg,
    a.journey-row:focus-visible .journey-row__arrow svg,
    a.journey-row:hover .journey-row__media img,
    a.journey-row:focus-visible .journey-row__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.journey_rows",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Where Will Your Next Journey Begin?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "From quiet trails in Latvia to sunlit paths in Italy and Portugal — find a route that feels close to you, and step into the journey at your own pace."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:labels.show_divider",
      "default": true
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "t:labels.row_height",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 270
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:labels.row_gap",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:general.row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Row title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.cta_link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "range",
          "id": "image_position",
          "label": "t:labels.image_position",
          "info": "t:info.image_position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.journey_rows",
      "blocks": [
        { "type": "row", "settings": { "title": "Hiking in Italy", "link": "/collections/hikes" } },
        { "type": "row", "settings": { "title": "Create a Hike With Us", "link": "/pages/create-a-hike" } },
        { "type": "row", "settings": { "title": "Shop Hiking Essentials", "link": "/collections/hiking-essentials" } }
      ]
    }
  ]
}
{% endschema %}
