{% comment %}
  Journey rows — the three ways into the store, below the Home page hero.

  An intro (heading plus one line of sub text) constrained to the centre column,
  followed by full-bleed image bands. Each band carries its title low on the left
  and an arrow on the far right, both in light ink over the photography.

  The bands break out edge-to-edge, but the caption is inset by `--page-margin`,
  so a row title lines up with the heading above it rather than with the viewport.

  Rows are blocks, so the set is not fixed at three: the preset ships the three
  from the design, and the merchant can add, remove or reorder from there. A row
  with no link renders as a `<div>` — an anchor with no destination is a trap for
  anyone tabbing through.

  Rows with no image fall back to demo photography while the `demo_images`
  setting is on. That is preview scaffolding — see the comment on `demo_ids`.
{% endcomment %}

{%- liquid
  comment
    Scaffolding: stand-in photography so the bands can be judged before any real
    images exist. Pexels ids, hotlinked from their CDN — nothing is committed to
    assets/. Ordered to match the preset: an Italian hillside, hikers on a ridge,
    a group seen from behind with their packs in frame. Turn the `demo_images`
    setting off (or pick real images) and this path is never reached. Delete the
    setting and this list before launch.
  endcomment
  assign demo_ids = '11086353,733162,3297271' | split: ','
-%}

{%- liquid
  assign intro_class = 'journey-rows__intro'
  if section.settings.show_divider
    assign intro_class = intro_class | append: ' journey-rows__intro--divided'
  endif

  comment
    The rule belongs to the heading, not to the section: with both text settings
    empty there is nothing for it to sit above, and a hairline floating under
    the hero reads as a mistake.
  endcomment
  assign has_intro = false
  if section.settings.heading != blank
    assign has_intro = true
  endif
  if section.settings.subheading != blank
    assign has_intro = true
  endif
-%}

{%- if has_intro -%}
  <div class="{{ intro_class }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="journey-rows__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="journey-rows__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="journey-rows full-width"
    style="--row-height-desktop: {{ section.settings.row_height }}px; --row-gap: {{ section.settings.row_gap }}px;"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign wrapper = 'div'
        if block.settings.link != blank
          assign wrapper = 'a'
        endif

        assign scrim = block.settings.overlay | divided_by: 100.0
        assign demo_index = forloop.index0 | modulo: demo_ids.size

        assign img_loading = 'lazy'
        assign img_priority = 'auto'
        if forloop.first
          assign img_loading = 'eager'
          assign img_priority = 'high'
        endif
      -%}

      <{{ wrapper }}
        class="journey-row"
        {% if wrapper == 'a' %}href="{{ block.settings.link }}"{% endif %}
        style="--row-scrim: {{ scrim }};"
        {{ block.shopify_attributes }}
      >
        <div class="journey-row__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 3000
              | image_tag:
                  widths: '750,1100,1500,2000,2600,3000',
                  sizes: '100vw',
                  loading: img_loading,
                  fetchpriority: img_priority,
                  alt: block.settings.image.alt
            }}
          {%- elsif section.settings.demo_images -%}
            {%- assign demo_id = demo_ids[demo_index] -%}
            {% # theme-check-disable RemoteAsset %}
            {%- comment -%}
              Hotlinked on purpose: demo photography must not be committed to
              assets/ or uploaded to the store. The band crops it with
              object-fit, so these dimensions only supply the aspect hint.
            {%- endcomment -%}
            <img
              src="https://images.pexels.com/photos/{{ demo_id }}/pexels-photo-{{ demo_id }}.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=2000"
              alt=""
              width="2000"
              height="1333"
              loading="{{ img_loading }}"
              fetchpriority="{{ img_priority }}"
            >
            {% # theme-check-enable RemoteAsset %}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'journey-row__placeholder' }}
          {%- endif -%}
        </div>

        <div class="journey-row__caption">
          {%- if block.settings.title != blank -%}
            <h3 class="journey-row__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          <span class="journey-row__arrow" aria-hidden="true">
            {{- 'icon-arrow-right.svg' | inline_asset_content -}}
          </span>
        </div>
      </{{ wrapper }}>
    {%- endfor -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .journey-rows__intro {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 3rem 1.5rem;
  }

  /**
   * Same 0.5px hairline the header and footer use. The space above it is
   * margin and the space below it padding, so the rule sits nearer the heading
   * it introduces than the section it is separating from.
   */
  .journey-rows__intro--divided {
    border-block-start: 0.5px solid var(--color-hairline);
    margin-block-start: 3rem;
    margin-block-end: 1.5rem;
    padding-block-start: 2rem;
  }

  .journey-rows {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
  }

  /**
   * The desktop band height arrives as `--row-height-desktop` on the inline
   * style attribute, which outranks any stylesheet rule. Mapping it onto the
   * used token inside a media query is what lets the mobile value below win at
   * narrow widths.
   */
  .journey-row {
    --row-height: min(56vw, 320px);
    --caption-inset: 1.5rem;

    /* How far the image dims under the cursor, on top of `--row-scrim`. */
    --row-hover-wash: 0.2;

    position: relative;
    display: block;
    height: var(--row-height);
    overflow: hidden;
    color: var(--color-on-image);
    text-decoration: none;
  }

  @media (width >= 750px) {
    .journey-row {
      --row-height: var(--row-height-desktop);
      --caption-inset: 3.5rem;
    }
  }

  .journey-row__media {
    position: absolute;
    inset: 0;
  }

  .journey-row__media img,
  .journey-row__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--easing-base);
  }

  /**
   * A legibility ramp, not a palette colour: the caption is light ink and the
   * photography underneath it is not guaranteed to be dark. Weighted to the
   * bottom of the band because that is where the caption sits, and faded out
   * well before the top so the image still reads as itself.
   *
   * On the media wrapper rather than the row: a pseudo-element paints after its
   * host's children, so a scrim on the row itself would land on top of the
   * caption and dim the very text it is there to hold up.
   */
  .journey-row__media::after {
    content: '';
    position: absolute;
    inset: 0;

    /**
     * Two layers on one element: the merchant's bottom-weighted scrim as the
     * background image, and a flat wash as the background colour underneath it.
     * Keeping them on separate properties is what makes the hover state
     * animate — a colour interpolates cleanly, a gradient does not.
     */
    background-image: linear-gradient(to top, rgb(0 0 0 / var(--row-scrim)) 0%, rgb(0 0 0 / 0) 65%);
    background-color: rgb(0 0 0 / 0);
    transition: background-color var(--duration-base) var(--easing-base);
  }

  /**
   * Inset to the centre column rather than to `--page-margin`, so a row title
   * starts on the same left edge as the heading above it. `--content-width`
   * comes from the `.shopify-section` grid and resolves its percentage against
   * the row, which is the same width as the section.
   */
  .journey-row__caption {
    position: absolute;
    inset-inline: calc((100% - var(--content-width)) / 2);
    bottom: var(--caption-inset);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* At the display step a title wraps and crowds the arrow on a phone. */
  .journey-row__title {
    font-size: var(--font-size-display-compact);
  }

  @media (width >= 750px) {
    .journey-row__title {
      font-size: var(--font-size-display);
    }
  }

  .journey-row__arrow {
    /* Pushed to the end so the arrow holds the right edge even without a title. */
    margin-inline-start: auto;
  }

  .journey-row__arrow svg {
    width: var(--size-icon);
    height: var(--size-icon);
    transition: transform var(--duration-base) var(--easing-base);
  }

  @media (width >= 750px) {
    .journey-row__arrow svg {
      width: 2.625rem;
      height: 2.625rem;
    }
  }

  /**
   * Only linked rows respond: an unlinked row is a picture, and a picture that
   * reacts to the cursor reads as broken. Focus-visible gets the same
   * treatment so the keyboard sees what the mouse sees.
   */
  a.journey-row:hover .journey-row__media::after,
  a.journey-row:focus-visible .journey-row__media::after {
    background-color: rgb(0 0 0 / var(--row-hover-wash));
  }

  a.journey-row:hover .journey-row__arrow svg,
  a.journey-row:focus-visible .journey-row__arrow svg {
    transform: translateX(0.375rem);
  }

  a.journey-row:hover .journey-row__media img,
  a.journey-row:focus-visible .journey-row__media img {
    transform: scale(1.03);
  }

  /* The global focus ring is black, which disappears against dark photography. */
  .journey-row:focus-visible {
    outline-color: var(--color-on-image);
    outline-offset: -6px;
  }

  /**
   * Reduced motion takes away the movement, not the feedback: the wash still
   * comes in, it just arrives without a fade.
   */
  @media (prefers-reduced-motion: reduce) {
    .journey-row__media img,
    .journey-row__media svg,
    .journey-row__media::after,
    .journey-row__arrow svg {
      transition: none;
    }

    a.journey-row:hover .journey-row__arrow svg,
    a.journey-row:focus-visible .journey-row__arrow svg,
    a.journey-row:hover .journey-row__media img,
    a.journey-row:focus-visible .journey-row__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.journey_rows",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Where Will Your Next Journey Begin?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "From quiet trails in Latvia to sunlit paths in Italy and Portugal — find a route that feels close to you, and step into the journey at your own pace."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:labels.show_divider",
      "default": true
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "t:labels.row_height",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:labels.row_gap",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "demo_images",
      "label": "t:labels.demo_images",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:general.row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Row title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.cta_link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "t:labels.overlay",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.journey_rows",
      "blocks": [
        { "type": "row", "settings": { "title": "Hiking in Italy", "link": "/collections/hikes" } },
        { "type": "row", "settings": { "title": "Create a Hike With Us", "link": "/pages/create-a-hike" } },
        { "type": "row", "settings": { "title": "Shop Hiking Essentials", "link": "/collections/hiking-essentials" } }
      ]
    }
  ]
}
{% endschema %}
