{% comment %}
  Mosaic hero — a heading and call to action above a full-bleed band of image
  columns that drifts sideways and loops seamlessly.
{% endcomment %}

{% comment %}
  Pack the flat block list into balanced columns by adding up each image's
  `height_ratio` until it would overshoot `column_fill`, producing a
  comma-separated count of images per column ("2,3,3") for the render loop.
{% endcomment %}

{%- liquid
  assign fill = section.settings.column_fill
  assign running = 0
  assign current = 0
  assign packed = ''

  for candidate in section.blocks
    assign ratio = candidate.settings.height_ratio
    assign next = running | plus: ratio

    if current == 0
      assign next = ratio
    elsif next > fill
      assign packed = packed | append: current | append: ','
      assign current = 0
      assign next = ratio
    endif

    assign current = current | plus: 1
    assign running = next
  endfor

  if current > 0
    assign packed = packed | append: current
  endif

  assign columns = packed | split: ','
-%}

{%- capture image_sizes %}(min-width: 750px) {{ section.settings.column_width }}px, 60vw{% endcapture -%}

<div class="mosaic-hero__intro">
  {%- if section.settings.heading != blank -%}
    <h1 class="mosaic-hero__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.settings.cta_label != blank -%}
    <a class="mosaic-hero__cta" href="{{ section.settings.cta_link | default: '#' }}">
      {{ section.settings.cta_label }}
      {{ 'icon-arrow-right.svg' | inline_asset_content }}
    </a>
  {%- endif -%}
</div>

{%- if section.blocks.size > 0 -%}
  {% comment %}
    The column set is rendered twice so the track can loop; the second pass is a
    decorative clone, which is why it carries no alt text and no
    `shopify_attributes`.
  {% endcomment %}
  <div
    class="mosaic full-width"
    style="--mosaic-band-desktop: {{ section.settings.band_height }}px; --mosaic-column-desktop: {{ section.settings.column_width }}px;"
  >
    <mosaic-marquee
      class="mosaic__viewport"
      role="group"
      aria-label="{{ 'general.accessibility.image_gallery' | t }}"
      data-speed="{{ section.settings.speed }}"
    >
      <div class="mosaic__track">
        {%- for pass in (1..2) -%}
          {%- liquid
            assign is_clone = false
            if pass == 2
              assign is_clone = true
            endif
            assign cursor = 0
          -%}

          <div class="mosaic__group" {% if is_clone %}aria-hidden="true"{% endif %}>
            {%- for count in columns -%}
              {%- assign column_size = count | plus: 0 -%}

              <div class="mosaic__column">
                {%- for offset in (1..column_size) -%}
                  {%- liquid
                    assign index = cursor | plus: offset | minus: 1
                    assign cell = section.blocks[index]

                    assign img_alt = cell.settings.image.alt
                    assign img_loading = 'lazy'
                    assign img_priority = 'auto'

                    if is_clone
                      assign img_alt = ''
                    else
                      if index == 0
                        assign img_loading = 'eager'
                        assign img_priority = 'high'
                      endif
                    endif
                  -%}

                  <figure
                    class="mosaic__cell"
                    style="--cell-ratio: {{ cell.settings.height_ratio }};"
                    {% unless is_clone %}{{ cell.shopify_attributes }}{% endunless %}
                  >
                    {%- if cell.settings.image != blank -%}
                      {{
                        cell.settings.image
                        | image_url: width: 1200
                        | image_tag:
                            widths: '200,300,400,600,800,1200',
                            sizes: image_sizes,
                            loading: img_loading,
                            fetchpriority: img_priority,
                            alt: img_alt
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'mosaic__placeholder' }}
                    {%- endif -%}
                  </figure>
                {%- endfor -%}
              </div>

              {%- assign cursor = cursor | plus: column_size -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </mosaic-marquee>
  </div>
{%- endif -%}

{% stylesheet %}
  .mosaic-hero__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block: 3rem 2.5rem;
  }

  .mosaic-hero__heading {
    max-width: 20ch;
    font-size: var(--font-size-hero);
    line-height: var(--line-height-hero);
    letter-spacing: var(--letter-spacing-hero);
  }

  .mosaic-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    font-size: var(--font-size-ui);
    line-height: var(--line-height-ui);
    text-decoration: none;
    white-space: nowrap;
  }

  .mosaic-hero__cta svg {
    width: 1.625rem;
    height: 1.625rem;
    transition: transform var(--duration-base) var(--easing-base);
  }

  .mosaic-hero__cta:hover svg {
    transform: translateX(0.25rem);
  }

  /* Desktop band and column sizes arrive as inline `--*-desktop` properties and
     are mapped onto the used tokens here, so the mobile values win below 750px. */
  .mosaic {
    --mosaic-gap: 1.25rem;
    --mosaic-band: min(78vh, 700px);
    --mosaic-column: 46vw;
  }

  @media (width >= 750px) {
    .mosaic {
      --mosaic-gap: 1.875rem;
      --mosaic-band: var(--mosaic-band-desktop);
      --mosaic-column: var(--mosaic-column-desktop);
    }
  }

  /* `will-change` promotes the clipping box itself, so the clip keeps up with
     the composited track at the moment its transform wraps. */
  .mosaic__viewport {
    display: block;
    height: var(--mosaic-band);
    overflow: hidden;
    will-change: transform;
  }

  .mosaic__track {
    display: flex;
    gap: var(--mosaic-gap);
    width: max-content;
    height: 100%;
    animation: mosaic-drift var(--mosaic-duration, 40s) linear infinite;
  }

  /* Deliberately not paused on hover: the band is taller than the fold, so a
     resting cursor would stop the drift for no reason the reader can see. */
  .mosaic:focus-within .mosaic__track {
    animation-play-state: paused;
  }

  .mosaic__group {
    display: flex;
    gap: var(--mosaic-gap);
    height: 100%;
  }

  .mosaic__column {
    display: flex;
    flex-direction: column;
    gap: var(--mosaic-gap);
    width: var(--mosaic-column);
    height: 100%;
  }

  .mosaic__cell {
    flex: var(--cell-ratio) 1 0;
    min-height: 0;
    overflow: hidden;
  }

  .mosaic__cell img,
  .mosaic__cell svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* `--mosaic-shift` is one group plus one gap, measured by the custom element;
     the `-50%` fallback covers the no-JavaScript case. */
  @keyframes mosaic-drift {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(var(--mosaic-shift, -50%), 0, 0);
    }
  }

  /* With the drift stopped, the band has to be reachable some other way. */
  @media (prefers-reduced-motion: reduce) {
    .mosaic__viewport {
      overflow-x: auto;
    }

    .mosaic__track {
      animation: none;
    }

    .mosaic-hero__cta svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Measures the rendered band to turn the merchant's speed setting into an
   * animation duration, and to keep enough copies of the column set on the
   * track that something always covers the viewport at the wrap.
   */
  class MosaicMarquee extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.mosaic__track');
      if (!this.track) return;

      this.groups = Array.from(this.track.children);
      if (this.groups.length < 2) return;

      this.sync = this.sync.bind(this);
      this.observer = new ResizeObserver(this.sync);
      this.observer.observe(this.groups[0]);

      /* The host is the only element here that tracks the viewport: above 750px
         the columns are a fixed px width. */
      this.observer.observe(this);

      this.sync();
    }

    disconnectedCallback() {
      if (this.observer) this.observer.disconnect();
    }

    sync() {
      const origin = this.groups[0].getBoundingClientRect().left;
      const repeat = this.groups[1].getBoundingClientRect().left - origin;
      if (!repeat) return;

      this.fill(repeat);

      const speed = parseFloat(this.dataset.speed) || 30;

      /* Assigning a new duration mid-flight preserves the animation's progress,
         so a resize reads as a change of pace rather than a jump. */
      this.track.style.setProperty('--mosaic-shift', `${-repeat}px`);
      this.track.style.setProperty('--mosaic-duration', `${(repeat / speed).toFixed(2)}s`);
    }

    /**
     * Tops the track up, in whole copies, until what remains after one repeat
     * has scrolled past still covers the viewport.
     */
    fill(repeat) {
      const viewport = this.getBoundingClientRect().width;
      const shortfall = viewport - (this.track.getBoundingClientRect().width - repeat);
      if (shortfall <= 0) return;

      let copies = Math.ceil(shortfall / repeat);
      while (copies--) {
        /* Clone the second group, never the first: it is already aria-hidden,
           lazy-loaded and free of shopify_attributes. */
        this.track.appendChild(this.groups[1].cloneNode(true));
      }
    }
  }

  if (!customElements.get('mosaic-marquee')) {
    customElements.define('mosaic-marquee', MosaicMarquee);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.mosaic_hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Experience More Than the Destination"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Explore Hikes"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    },
    {
      "type": "range",
      "id": "band_height",
      "label": "t:labels.band_height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 1080
    },
    {
      "type": "range",
      "id": "column_width",
      "label": "t:labels.column_width",
      "min": 200,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 410
    },
    {
      "type": "range",
      "id": "column_fill",
      "label": "t:labels.column_fill",
      "min": 6,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:labels.speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:general.image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "range",
          "id": "height_ratio",
          "label": "t:labels.height_ratio",
          "min": 1,
          "max": 12,
          "step": 1,
          "unit": "fr",
          "default": 6
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.mosaic_hero",
      "blocks": [
        { "type": "image", "settings": { "height_ratio": 6 } },
        { "type": "image", "settings": { "height_ratio": 6 } },
        { "type": "image", "settings": { "height_ratio": 1 } },
        { "type": "image", "settings": { "height_ratio": 6 } },
        { "type": "image", "settings": { "height_ratio": 5 } },
        { "type": "image", "settings": { "height_ratio": 4 } },
        { "type": "image", "settings": { "height_ratio": 6 } },
        { "type": "image", "settings": { "height_ratio": 2 } }
      ]
    }
  ]
}
{% endschema %}
